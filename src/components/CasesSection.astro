---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const items = t<{ logoAlt: string; eyebrow: string; title: string; text: string }[]>('cases.items');

const visuals = [
  { image: '/images/case-embraer.webp', logo: '/logos/embraer-logo.svg', logoStyle: 'height:16px;width:auto;display:block;filter:brightness(0) invert(1);' },
  { image: '/images/case-serasa.webp', logo: '/logos/serasa-logo.svg', logoStyle: 'height:25px;width:auto;display:block;filter:brightness(0) invert(1);object-fit:contain;max-width:100%;' },
  { image: '/images/case-pagseguro.webp', logo: '/logos/pagseguro-logo.svg', logoStyle: 'height:22px;width:auto;display:block;' },
];
---
<section class="cases" id="cases">
  <div class="section-intro"><p class="eyebrow">{t('cases.eyebrow')}</p><h2>{t('cases.title')}</h2></div>
  <p class="section-copy">{t('cases.intro')}</p>
  <div class="cases-grid">
    {items.map((item, i) => (
      <article class="case-card">
        <div class="case-image" style={`background-image:url('${visuals[i].image}');`}>
          <span class="case-logo-badge"><img src={visuals[i].logo} alt={item.logoAlt} style={visuals[i].logoStyle} /></span>
        </div>
        <div class="case-body"><span class="case-eyebrow">{item.eyebrow}</span><h3>{item.title}</h3><p>{item.text}</p></div>
      </article>
    ))}
  </div>
</section>
