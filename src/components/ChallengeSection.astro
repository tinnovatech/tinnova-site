---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const cards = t<{ title: string; text: string }[]>('challenge.cards');
const icons = ['cloud-sync.svg', 'network-nodes-1.svg', 'box-arrows.svg', 'network-nodes-2.svg'];
---
<section class="desafio" id="desafio-real">
  <div class="section-intro">
    <p class="eyebrow">{t('challenge.eyebrow')}</p>
    <h2>{t('challenge.title')}</h2>
  </div>
  <p class="section-copy">{t('challenge.intro')}</p>
  <div class="challenge-grid">
    {cards.map((card, i) => (
      <div class="challenge-card"><img src={`/logos/desafio/${icons[i]}`} alt="" aria-hidden="true"><h3>{card.title}</h3><p>{card.text}</p></div>
    ))}
  </div>
</section>
