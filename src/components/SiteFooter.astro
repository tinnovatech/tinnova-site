---
import { CONTACT_EMAIL, WHATSAPP_URL, WHATSAPP_DISPLAY, SOCIAL_LINKS, COMPANY } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localeHref, useTranslations } from '../i18n/utils';
import { getSolucoesForLocale } from '../content/solucoes-utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const solucoes = await getSolucoesForLocale(currentLocale);
const href = (path: string) => localeHref(currentLocale, path);
---
<footer class="site-footer">
  <div class="footer-wrap">
    <div class="footer-top"><img src="/logos/tinnova-logo-white.svg" alt="Tinnova"><p>{t('footer.tagline')}</p></div>
    <div class="footer-main">
      <div class="footer-contact"><span class="title">{t('footer.attendance')}</span><div class="details"><p><a href={`mailto:${CONTACT_EMAIL}`}>{t('footer.emailLabel')} {CONTACT_EMAIL}</a></p><p><a href={WHATSAPP_URL} target="_blank" rel="noopener">{t('footer.phoneLabel')} {WHATSAPP_DISPLAY} {t('footer.phoneSuffix')}</a></p></div><a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-pill" style="width:fit-content;">{t('footer.ctaWhatsapp')} <span aria-hidden="true">↗</span></a><div class="footer-legal-block"><p class="addr">{COMPANY.addressLines[0]}, {COMPANY.addressLines[1]}</p><p class="cnpj">CNPJ {COMPANY.cnpj}</p></div></div>
      <div class="footer-cols">
        <div class="footer-col"><strong>{t('footer.colInstitutional')}</strong><a href={href('#cases')}>{t('nav.cases')}</a><a href={SOCIAL_LINKS.blog} target="_blank" rel="noopener">{t('nav.blog')}</a><a href={SOCIAL_LINKS.carreiras} target="_blank" rel="noopener">{t('nav.careers')}</a></div>
        <div class="footer-col"><strong>{t('footer.colSolutions')}</strong>{solucoes.map((s) => <a href={href(`/solucoes/${s.slug}/`)}>{s.data.name}</a>)}</div>
        <div class="footer-col"><strong>{t('footer.colContact')}</strong><a href="#contato">{t('footer.linkContact')}</a><a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener">Instagram</a></div>
        <div class="footer-col"><strong>{t('footer.colLegal')}</strong><a href={href('/politica-de-privacidade/')}>{t('footer.linkPrivacy')}</a><a href={href('/central-de-denuncia/')}>{t('footer.linkReport')}</a></div>
      </div>
    </div>
    <p class="footer-bottom">{COMPANY.legalName}- {t('footer.copyright')}</p>
  </div>
</footer>
