---
import { WEB3FORMS_DENUNCIA_ACCESS_KEY } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
---
<form class="contato-form" id="reportForm" action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="access_key" value={WEB3FORMS_DENUNCIA_ACCESS_KEY}>
  <input type="hidden" name="subject" value="Nova denúncia pelo site Tinnova - Central de Denúncia">
  <input type="hidden" name="from_name" value="Site Tinnova - Central de Denúncia">
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form-grid">
    <div class="form-field full">
      <label for="identificacao">{t('reportForm.identificacaoLabel')}</label>
      <select id="identificacao" name="identificacao" required>
        <option value="Sim">{t('reportForm.identificacaoYes')}</option>
        <option value="Não">{t('reportForm.identificacaoNo')}</option>
      </select>
    </div>
    <div class="form-field">
      <label for="nome">{t('reportForm.nomeLabel')}</label>
      <input type="text" id="nome" name="nome" placeholder={t('reportForm.nomePlaceholder')}>
    </div>
    <div class="form-field">
      <label for="telefone">{t('reportForm.telefoneLabel')}</label>
      <input type="tel" id="telefone" name="telefone" placeholder={t('reportForm.telefonePlaceholder')}>
    </div>
    <div class="form-field full">
      <label for="email">{t('reportForm.emailLabel')}</label>
      <input type="email" id="email" name="email" placeholder={t('reportForm.emailPlaceholder')}>
    </div>
    <div class="form-field full">
      <label for="descricao">{t('reportForm.descricaoLabel')}</label>
      <textarea id="descricao" name="descricao" placeholder={t('reportForm.descricaoPlaceholder')} required></textarea>
    </div>
    <div class="form-field full">
      <label for="anexo">{t('reportForm.anexoLabel')}</label>
      <input type="file" id="anexo" name="attachment">
    </div>
  </div>
  <div class="form-footer">
    <button type="submit" class="form-submit">{t('reportForm.submit')} <span aria-hidden="true">↗</span></button>
    <small>{t('reportForm.disclaimer')}</small>
  </div>
  <p class="form-msg" id="reportFormMsg"></p>
</form>

<script define:vars={{ sendingText: t('reportForm.submitSending'), successText: t('reportForm.successMsg'), errorText: t('reportForm.errorMsg') }}>
(function(){
  var form = document.getElementById('reportForm');
  var msg = document.getElementById('reportFormMsg');
  if(!form) return;

  var identificacao = document.getElementById('identificacao');
  var nome = document.getElementById('nome');
  var email = document.getElementById('email');
  var telefone = document.getElementById('telefone');

  function updateRequiredFields(){
    var identificado = identificacao.value === 'Sim';
    nome.required = identificado;
    email.required = identificado;
    telefone.required = identificado;
  }
  identificacao.addEventListener('change', updateRequiredFields);
  updateRequiredFields();

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!form.checkValidity()){
      form.reportValidity();
      return;
    }
    var submitBtn = form.querySelector('.form-submit');
    var originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = sendingText;
    msg.className = 'form-msg';

    var formData = new FormData(form);
    fetch(form.action, {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: formData
    })
    .then(function(res){ return res.json(); })
    .then(function(data){
      if(data.success){
        msg.textContent = successText;
        msg.className = 'form-msg show ok';
        form.reset();
      } else {
        throw new Error(data.message || 'Falha no envio');
      }
    })
    .catch(function(){
      msg.textContent = errorText;
      msg.className = 'form-msg show err';
    })
    .finally(function(){
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    });
  });
})();
</script>
