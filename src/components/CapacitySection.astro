---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const items = t<string[]>('capacity.items');
---
<section class="capacidade" id="capacidade-tecnica">
  <div class="container">
    <div class="capacidade-copy"><p class="eyebrow">{t('capacity.eyebrow')}</p><h2>{t('capacity.title')}</h2><p>{t('capacity.text')}</p></div>
    <div class="capacidade-list">
      {items.map((item, i) => (
        <div class="capacidade-row"><span class="num">{String(i + 1).padStart(2, '0')}</span><span class="title">{item}</span><span class="arrow">↗</span></div>
      ))}
    </div>
  </div>
</section>
