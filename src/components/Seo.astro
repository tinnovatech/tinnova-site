---
import { SITE_NAME, SOCIAL_LINKS, CONTACT_EMAIL, WHATSAPP_NUMBER, COMPANY } from '../consts';
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from '../i18n/config';
import { getLocalizedLinks } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/hero-banner.webp' } = Astro.props;

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const alternateLinks = getLocalizedLinks(Astro.url.pathname);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  logo: new URL('/logos/tinnova-logo.svg', Astro.site).toString(),
  email: CONTACT_EMAIL,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.addressLines[0],
    addressLocality: 'São José dos Campos',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.instagram, SOCIAL_LINKS.blog],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{alternateLinks.map((link) => (
  <link rel="alternate" hreflang={link.meta.hreflang} href={new URL(link.href, Astro.site)} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(alternateLinks.find((l) => l.locale === DEFAULT_LOCALE)!.href, Astro.site)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={LOCALE_META[currentLocale].ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
