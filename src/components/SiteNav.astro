---
import { SOCIAL_LINKS } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localeHref, useTranslations } from '../i18n/utils';
import { getSolucoesForLocale } from '../content/solucoes-utils';
import LanguageSelector from './LanguageSelector.astro';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const solucoes = await getSolucoesForLocale(currentLocale);
const href = (path: string) => localeHref(currentLocale, path);
---
<div class="site-nav">
  <nav class="nav-pill" aria-label={t('nav.ariaMain')}>
    <a href={href('#hero')} class="nav-logo" aria-label={t('nav.ariaHome')}><img src="/logos/tinnova-logo.svg" alt="Tinnova"></a>
    <div class="nav-links">
      <div class="nav-item" data-dropdown><button type="button" aria-expanded="false">{t('nav.solutions')}<svg class="chevron" viewBox="0 0 9 5" fill="none"><path d="M1 1L4.5 4L8 1" stroke="#293354" stroke-width="1.4" stroke-linecap="round"/></svg></button><div class="nav-dropdown"><div class="nav-dropdown-grid">
        {solucoes.map((s) => <a href={href(`/solucoes/${s.slug}/`)}>{s.data.name}</a>)}
      </div></div></div>
      <div class="nav-item"><a href={href('#cases')}>{t('nav.cases')}</a></div><div class="nav-item"><a href={SOCIAL_LINKS.blog} target="_blank" rel="noopener">{t('nav.blog')}</a></div><div class="nav-item"><a href={SOCIAL_LINKS.carreiras} target="_blank" rel="noopener">{t('nav.careers')}</a></div>
    </div>
    <LanguageSelector />
    <a href="#contato" class="btn-pill nav-cta">{t('nav.cta')}</a>
  </nav>
  <div class="mobile-nav"><a href={href('#hero')} aria-label={t('nav.ariaHome')}><img src="/logos/tinnova-logo.svg" alt="Tinnova"></a><div class="mobile-actions"><svg class="icon-btn" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><LanguageSelector class="lang-switcher-mobile" /><button type="button" class="icon-btn" id="mobileMenuOpen" aria-label={t('nav.mobileOpen')}><svg viewBox="0 0 24 24" fill="none"><path d="M3 6H21M3 12H21M3 18H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div></div>
</div>
<div class="mobile-menu-overlay" id="mobileMenuOverlay">
  <div class="mobile-menu-header"><img src="/logos/tinnova-logo.svg" alt="Tinnova"><button type="button" class="mobile-menu-close" id="mobileMenuClose" aria-label={t('nav.mobileClose')}>&times;</button></div>
  <div class="mobile-accordion">
    <div class="mobile-accordion-item" data-accordion><button type="button">{t('nav.solutions')}<svg class="chevron" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="#293354" stroke-width="1.4" stroke-linecap="round"/></svg></button><div class="mobile-accordion-panel">{solucoes.map((s) => <a href={href(`/solucoes/${s.slug}/`)}>{s.data.name}</a>)}</div></div>
    <a href={href('#cases')} class="mobile-plain-link" data-close-mobile-menu>{t('nav.cases')}</a><a href={SOCIAL_LINKS.blog} target="_blank" rel="noopener" class="mobile-plain-link">{t('nav.blog')}</a><a href={SOCIAL_LINKS.carreiras} target="_blank" rel="noopener" class="mobile-plain-link">{t('nav.careers')}</a>
  </div>
  <div class="mobile-menu-cta"><a href="#contato" class="btn-primary" data-close-mobile-menu>{t('nav.cta')}</a></div>
</div>
