---
// Runs as early as possible in <head>, before the page paints, so a language
// mismatch is corrected with a single redirect instead of a visible flash.
// Plain vanilla JS on purpose: this must work without any client framework
// and before hydration concerns even apply (the site is fully static).
---
<script is:inline>
(function () {
  var STORAGE_KEY = 'tinnova:lang';
  var SUPPORTED = ['pt-BR', 'en', 'es'];
  var DEFAULT_LOCALE = 'pt-BR';

  function detectBrowserLocale() {
    var candidates = navigator.languages && navigator.languages.length
      ? navigator.languages
      : [navigator.language || navigator.userLanguage || DEFAULT_LOCALE];

    for (var i = 0; i < candidates.length; i++) {
      var l = (candidates[i] || '').toLowerCase();
      if (l.indexOf('pt') === 0) return 'pt-BR';
      if (l.indexOf('en') === 0) return 'en';
      if (l.indexOf('es') === 0) return 'es';
    }
    return DEFAULT_LOCALE;
  }

  function localeFromPath(pathname) {
    var segment = pathname.split('/').filter(Boolean)[0];
    return SUPPORTED.indexOf(segment) > -1 ? segment : DEFAULT_LOCALE;
  }

  function withLocale(pathname, locale) {
    var parts = pathname.split('/').filter(Boolean);
    if (parts.length && SUPPORTED.indexOf(parts[0]) > -1) parts.shift();
    var suffix = parts.join('/');
    var base = locale === DEFAULT_LOCALE ? '/' : '/' + locale + '/';
    return suffix ? base + suffix + '/' : base;
  }

  try {
    var currentLocale = localeFromPath(window.location.pathname);
    var savedLocale = null;
    try {
      savedLocale = window.localStorage.getItem(STORAGE_KEY);
    } catch (e) {}

    var targetLocale;
    if (savedLocale && SUPPORTED.indexOf(savedLocale) > -1) {
      targetLocale = savedLocale;
    } else {
      targetLocale = detectBrowserLocale();
      try {
        window.localStorage.setItem(STORAGE_KEY, targetLocale);
      } catch (e) {}
    }

    if (targetLocale !== currentLocale) {
      var destination = withLocale(window.location.pathname, targetLocale) + window.location.search + window.location.hash;
      window.location.replace(destination);
    }
  } catch (e) {}
})();
</script>
