---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
---
<section class="pilares" id="pilares">
  <div class="container">
    <p class="pilares-label">{t('pillars.label')}</p>
    <div class="pilares-logos">
      <img src="/logos/pilares/embraer-white.svg" alt="Embraer">
      <img src="/logos/pilares/pagbank-white.svg" alt="PagBank">
      <img src="/logos/pilares/boeing-white.svg" alt="Boeing">
      <img src="/logos/pilares/serasa-white.svg" alt="Serasa">
      <img src="/logos/pilares/pirelli-white.svg" alt="Pirelli">
      <img src="/logos/pilares/dmcard-white.svg" alt="DM+CARD" style="height:calc(var(--logo-h) * 34 / 28);">
    </div>
  </div>
</section>
