---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const titleLines = t<string[]>('hero.titleLines');
---
<section class="hero" id="hero">
  <div class="hero-bg"></div>
  <div class="hero-copy">
    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1>{titleLines.map((line, i) => <>{line}{i < titleLines.length - 1 && <br />}</>)}</h1>
    <p class="lead">{t('hero.lead')}</p>
    <div class="hero-cta-row">
      <a href="#contato" class="btn-primary">{t('hero.ctaPrimary')} <span aria-hidden="true">↗</span></a>
      <a href="#desafio-real" class="text-link">{t('hero.ctaSecondary')} <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>
