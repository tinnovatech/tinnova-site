---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const steps = t<{ num: string; title: string; text: string }[]>('method.steps');
---
<section class="metodo" id="metodo">
  <div class="metodo-title"><p class="eyebrow">{t('method.eyebrow')}</p><h2>{t('method.title')}</h2></div>
  <div class="metodo-content">
    <div class="metodo-image">
      <picture>
        <source media="(max-width:1300px)" srcset="/images/metodo-visao-MOBILE.webp">
        <img src="/images/metodo-visao.webp" alt={t('method.imageAlt')}>
      </picture>
    </div>
    <div class="metodo-steps-wrap">
      <div class="metodo-steps">
        {steps.map((step) => (
          <div class="metodo-step"><span class="num">{step.num}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></div>
        ))}
      </div>
      <a href="#contato" class="btn-primary" style="align-self:flex-start;">{t('method.cta')}</a>
    </div>
  </div>
</section>
