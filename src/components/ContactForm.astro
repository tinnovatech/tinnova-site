---
import { WEB3FORMS_ACCESS_KEY, WHATSAPP_CHAT_URL } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  subject: string;
  fromName: string;
  pageCode: string;
}
const { subject, fromName, pageCode } = Astro.props;

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
---
<form class="contato-form" id="contactForm" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY}>
  <input type="hidden" name="subject" value={subject}>
  <input type="hidden" name="from_name" value={fromName}>
  <input type="hidden" name="form_page" value={pageCode}>
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form-grid">
    <div class="form-field">
      <label for="nome">{t('form.nomeLabel')}</label>
      <input type="text" id="nome" name="nome" placeholder={t('form.nomePlaceholder')} required>
    </div>
    <div class="form-field">
      <label for="cargo">{t('form.cargoLabel')}</label>
      <input type="text" id="cargo" name="cargo" placeholder={t('form.cargoPlaceholder')}>
    </div>
    <div class="form-field">
      <label for="empresa">{t('form.empresaLabel')}</label>
      <input type="text" id="empresa" name="empresa" placeholder={t('form.empresaPlaceholder')}>
    </div>
    <div class="form-field">
      <label for="email">{t('form.emailLabel')}</label>
      <input type="email" id="email" name="email" placeholder={t('form.emailPlaceholder')} required>
    </div>
    <div class="form-field">
      <label for="telefone">{t('form.telefoneLabel')}</label>
      <input type="tel" id="telefone" name="telefone" placeholder={t('form.telefonePlaceholder')} required>
    </div>
    <div class="form-field full">
      <label for="mensagem">{t('form.mensagemLabel')}</label>
      <textarea id="mensagem" name="mensagem" placeholder={t('form.mensagemPlaceholder')} required></textarea>
    </div>
  </div>
  <div class="form-footer">
    <button type="submit" class="form-submit">{t('form.submit')} <span aria-hidden="true">↗</span></button>
    <small>{t('form.disclaimer')}</small>
  </div>
  <p class="form-msg" id="formMsg"></p>
</form>

<script define:vars={{ whatsappUrl: WHATSAPP_CHAT_URL, sendingText: t('form.submitSending'), successText: t('form.successMsg'), errorText: t('form.errorMsg') }}>
(function(){
  var form = document.getElementById('contactForm');
  var msg = document.getElementById('formMsg');
  if(!form) return;

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!form.checkValidity()){
      form.reportValidity();
      return;
    }
    var submitBtn = form.querySelector('.form-submit');
    var originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = sendingText;
    msg.className = 'form-msg';

    var formData = new FormData(form);
    fetch(form.action, {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: formData
    })
    .then(function(res){ return res.json(); })
    .then(function(data){
      if(data.success){
        msg.textContent = successText;
        msg.className = 'form-msg show ok';
        form.reset();
        window.open(whatsappUrl, '_blank', 'noopener');
      } else {
        throw new Error(data.message || 'Falha no envio');
      }
    })
    .catch(function(){
      msg.textContent = errorText;
      msg.className = 'form-msg show err';
    })
    .finally(function(){
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    });
  });
})();
</script>
