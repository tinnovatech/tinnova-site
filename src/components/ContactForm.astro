---
import { WHATSAPP_CHAT_URL } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  pageCode: string;
}
const { pageCode } = Astro.props;

// Public site key of the Turnstile widget for tinnova.com.br and www.tinnova.com.br.
// Replace it before the pull request: the value comes from step OPS-028-01 of
// specs/028-site-form-leads/quickstart.md in tinnovatech/tinnova-crm. It is public by design.
const TURNSTILE_SITE_KEY = 'REPLACE_WITH_TURNSTILE_SITE_KEY';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
---
<form class="contato-form" id="contactForm" method="POST">
  <input type="hidden" name="form_page" value={pageCode}>
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form-grid">
    <div class="form-field">
      <label for="nome">{t('form.nomeLabel')}</label>
      <input type="text" id="nome" name="nome" maxlength="200" placeholder={t('form.nomePlaceholder')} required>
    </div>
    <div class="form-field">
      <label for="cargo">{t('form.cargoLabel')}</label>
      <input type="text" id="cargo" name="cargo" maxlength="200" placeholder={t('form.cargoPlaceholder')}>
    </div>
    <div class="form-field">
      <label for="empresa">{t('form.empresaLabel')}</label>
      <input type="text" id="empresa" name="empresa" maxlength="200" placeholder={t('form.empresaPlaceholder')}>
    </div>
    <div class="form-field">
      <label for="email">{t('form.emailLabel')}</label>
      <input type="email" id="email" name="email" maxlength="254" placeholder={t('form.emailPlaceholder')} required>
    </div>
    <div class="form-field">
      <label for="telefone">{t('form.telefoneLabel')}</label>
      <input type="tel" id="telefone" name="telefone" maxlength="40" placeholder={t('form.telefonePlaceholder')} required>
    </div>
    <div class="form-field full">
      <label for="mensagem">{t('form.mensagemLabel')}</label>
      <textarea id="mensagem" name="mensagem" maxlength="5000" placeholder={t('form.mensagemPlaceholder')} required></textarea>
    </div>
  </div>
  <div id="turnstileWidget" class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-action="contato"></div>
  <div class="form-footer">
    <button type="submit" class="form-submit">{t('form.submit')} <span aria-hidden="true">↗</span></button>
    <small>{t('form.disclaimer')}</small>
  </div>
  <p class="form-msg" id="formMsg"></p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script define:vars={{ whatsappUrl: WHATSAPP_CHAT_URL, sendingText: t('form.submitSending'), successText: t('form.successMsg'), errorText: t('form.errorMsg'), rateLimitText: t('form.rateLimitMsg') }}>
(function(){
  var form = document.getElementById('contactForm');
  var msg = document.getElementById('formMsg');
  var widget = document.getElementById('turnstileWidget');
  var endpoint = 'https://crm.tinnova.net.br/api/site-form';
  if(!form) return;

  function show(text, kind){
    msg.textContent = text;
    msg.className = 'form-msg show ' + kind;
  }

  // A Turnstile token works once. Reset after every attempt so the next submit carries a new one.
  function resetChallenge(){
    if(window.turnstile) window.turnstile.reset(widget);
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!form.checkValidity()){
      form.reportValidity();
      return;
    }
    var submitBtn = form.querySelector('.form-submit');
    var originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = sendingText;
    msg.className = 'form-msg';

    var payload = {
      form_page: form.elements['form_page'].value,
      nome: form.elements['nome'].value,
      cargo: form.elements['cargo'].value,
      empresa: form.elements['empresa'].value,
      email: form.elements['email'].value,
      telefone: form.elements['telefone'].value,
      mensagem: form.elements['mensagem'].value,
      botcheck: form.elements['botcheck'].checked ? 'on' : '',
      turnstile_token: (window.turnstile && window.turnstile.getResponse(widget)) || ''
    };

    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(res){
      if(res.status === 202){
        show(successText, 'ok');
        form.reset();
        window.open(whatsappUrl, '_blank', 'noopener');
        return;
      }
      if(res.status === 429){
        // Only the API's own 429 carries the code; an edge 429 has no readable body and falls to errorText.
        return res.json().then(function(body){
          show(body && body.code === 'rate_limited' ? rateLimitText : errorText, 'err');
        });
      }
      show(errorText, 'err');
    })
    .catch(function(){
      show(errorText, 'err');
    })
    .finally(function(){
      resetChallenge();
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    });
  });
})();
</script>
