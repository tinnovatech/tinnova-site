---
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import SecurityMeta from '../components/SecurityMeta.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
import ClarityTag from '../components/ClarityTag.astro';
import SiteScripts from '../components/SiteScripts.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LangDetectScript from '../components/LangDetectScript.astro';
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
---
<!DOCTYPE html>
<html lang={LOCALE_META[currentLocale].hreflang}>
<head>
<meta charset="UTF-8">
<SecurityMeta />
<LangDetectScript />
<GtmHead />
<ClarityTag />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<Seo title={title} description={description} image={image} />
<link rel="icon" type="image/svg+xml" href="/logos/tinnova-symbol.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"></noscript>
<style is:global>
  section[id]{scroll-margin-top:110px;}
  @media (max-width:880px){ section[id]{scroll-margin-top:90px;} }

  /* ============ BREADCRUMB ============ */
  .breadcrumb-wrap{padding:178px var(--page-pad) 0;}
  .breadcrumb{display:flex;gap:9px;align-items:center;padding-bottom:18px;font-size:12px;color:var(--muted-gray);flex-wrap:wrap;}
  .breadcrumb a{color:var(--muted-gray);}
  .breadcrumb a:hover{color:var(--purple);}
  .breadcrumb strong{color:var(--navy);font-weight:600;}

  /* ============ HERO (product page) ============ */
  .hero2{
    padding:50px var(--page-pad) 90px;
    display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center;
  }
  .hero2 .eyebrow{color:var(--purple);}
  .hero2 h1{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;
    color:var(--near-black);max-width:1090px;
  }
  .hero2 .lead{
    font-weight:400;font-size:20px;line-height:26.4px;color:var(--muted-gray);
    max-width:1206px;padding-top:8px;
  }
  .hero-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px 28px;padding-top:16px;}
  .hero-actions .text-link{color:var(--navy);}
  .hero-actions .text-link span{color:var(--purple);}

  .hero-challenge{display:none;}
  .hero-media{width:100%;height:856px;overflow:hidden;background:var(--navy);}
  .hero-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ DESAFIO (challenge) ============ */
  .challenge{
    background:#fff;border-bottom:1px solid var(--border-navy);
    padding:64px var(--page-pad);display:flex;justify-content:center;
  }
  .challenge-wrap{width:100%;display:flex;gap:40px;align-items:flex-start;}
  .challenge-label{
    font-family:'Poppins',sans-serif;font-weight:600;font-size:24px;letter-spacing:-0.24px;
    text-transform:uppercase;color:var(--purple-dark);flex:0 0 auto;max-width:260px;
  }
  .challenge-text{
    font-size:24px;line-height:33.6px;letter-spacing:-0.24px;color:var(--muted-gray);
    max-width:975px;
  }

  /* ============ CENARIO ============ */
  .cenario{background:#fff;padding:90px var(--page-pad) 150px;display:flex;justify-content:center;}
  .cenario-wrap{width:100%;display:flex;gap:44px;align-items:center;}
  .cenario-copy{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:32px;}
  .cenario-copy .eyebrow{color:var(--purple);}
  .cenario-copy h2{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);
    max-width:863px;
  }
  .cenario-copy .body{font-size:16px;line-height:26.4px;color:var(--muted-gray);max-width:849px;}
  .cenario-copy .body p+p{margin-top:20px;}
  .cenario-media{flex:0 0 534px;width:534px;height:640px;overflow:hidden;border-radius:4px;background:var(--lavender);}
  .cenario-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ SOLUCAO / COMO FAZEMOS (centered box) ============ */
  /* A solução + Como fazemos: two consecutive sections on one grey band.
     Editorial layout (heading left, text right); the second one is pulled up
     and separated by a thin rule instead of a second full padding. */
  .story-section{background:rgba(245,245,245,0.95);padding:90px var(--page-pad);display:flex;justify-content:center;}
  .story-section + .story-section{padding-top:0;}
  .story-section + .story-section .story-wrap{border-top:1px solid var(--border-navy);padding-top:64px;}
  .story-section:has(+ .story-section){padding-bottom:64px;}
  .story-wrap{
    width:100%;max-width:1320px;
    display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
    gap:clamp(40px,6vw,110px);align-items:start;text-align:left;
  }
  .story-head{display:flex;flex-direction:column;gap:17px;}
  .story-wrap .eyebrow{color:var(--purple);}
  .story-wrap h2{font-weight:500;font-size:44px;line-height:1.2;letter-spacing:-2px;color:var(--near-black);}
  .story-body{font-size:17px;line-height:28px;color:var(--muted-gray);padding-top:36px;}
  .story-body p+p{margin-top:20px;}

  /* ============ BENEFICIOS ============ */
  .beneficios{
    background:#fff;padding:100px var(--page-pad) 130px;
    display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);
    gap:clamp(48px,7vw,130px);align-items:start;
  }
  .beneficios-aside{display:flex;flex-direction:column;align-items:flex-start;gap:32px;}
  .beneficios-head{display:flex;flex-direction:column;gap:17px;}
  .beneficios-head .eyebrow{color:var(--purple);}
  .beneficios-head h2{font-weight:500;font-size:48px;line-height:1.2;letter-spacing:-2.4px;color:var(--near-black);}
  .beneficios-head p{font-size:17px;line-height:27px;color:var(--muted-gray);max-width:500px;}
  .beneficios-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--border-navy);}
  .beneficios-list li{display:flex;align-items:flex-start;gap:18px;padding:26px 0;border-bottom:1px solid var(--border-navy);}
  .beneficio-check{
    flex:none;width:26px;height:26px;margin-top:1px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    background:rgba(111,57,150,.1);color:var(--purple);
  }
  .beneficios-list p{font-size:18px;line-height:28px;color:var(--navy);}

  /* ============ CONTATO (about cards + final CTA/form) ============ */
  .contato-final{
    background:linear-gradient(101deg, rgb(61,40,109) 0%, rgb(50,61,114) 100%);
    padding:93px var(--page-pad) 90px;display:flex;flex-direction:column;align-items:center;gap:65px;
  }
  .about-panel{
    width:100%;background:#f5f5f5;border:1px solid var(--border-navy);
    border-radius:10px;display:flex;flex-direction:column;
  }
  .about-card{
    display:flex;gap:60px;align-items:center;justify-content:center;padding:47px 40px;
    border-bottom:1px solid rgba(101,106,130,0.49);flex-wrap:wrap;
  }
  .about-card:last-child{border-bottom:none;}
  .about-card .label{
    display:flex;flex-direction:column;gap:13px;flex:0 0 389px;max-width:389px;
  }
  .about-card .tag{font-weight:600;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--purple);}
  .about-card h3{font-weight:600;font-size:22px;letter-spacing:-0.44px;color:var(--near-black);}
  .about-card p{font-size:15px;line-height:24.75px;color:var(--muted-gray);flex:0 0 420px;max-width:420px;}

  .final-row{width:100%;padding:23px 0;display:flex;gap:80px;align-items:flex-start;flex-wrap:wrap;}
  .final-copy{flex:1 1 380px;max-width:760px;display:flex;flex-direction:column;gap:18px;}
  .final-copy .eyebrow{font-size:11px;letter-spacing:1.76px;color:var(--ice-blue);}
  .final-copy h2{font-weight:600;font-size:44px;line-height:47.52px;letter-spacing:-0.88px;color:#fff;}
  .final-copy p{font-size:16px;line-height:26.4px;color:rgba(255,255,255,0.72);max-width:541px;}
  .final-form-wrap{flex:1 1 380px;max-width:560px;width:100%;}

  /* ============================================================
     RESPONSIVE — MOBILE (matches Figma mobile frame, 440px, sem imagens)
     ============================================================ */
  @media (max-width: 880px){
    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(247,244,249,0.96);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);height:76px;padding:0 20px;
      pointer-events:auto;width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    .breadcrumb-wrap{padding:100px 24px 0;}
    .breadcrumb{justify-content:center;text-align:center;}

    .hero2{padding:24px 24px 48px;gap:14px;}
    .hero2 h1{font-size:31px;line-height:40px;letter-spacing:-.3px;}
    .hero2 .lead{font-size:16px;}
    .hero-actions{flex-direction:column;gap:16px;width:100%;}
    .hero-actions .btn-primary{width:100%;justify-content:center;}

    .hero-media{display:none;}

    /* "O desafio" moves into the hero, above the CTAs. */
    .challenge{display:none;}
    .hero-challenge{
      display:flex;flex-direction:column;align-items:center;gap:8px;
      width:100%;margin-top:10px;padding:22px 20px;
      border-radius:16px;background:var(--lavender);
    }
    .hero-challenge-label{font-weight:600;font-size:13px;letter-spacing:1.6px;text-transform:uppercase;color:var(--purple);}
    .hero-challenge-text{font-size:16px;line-height:25px;color:var(--navy);}

    .cenario{padding:48px 24px 60px;}
    .cenario-wrap{flex-direction:column;padding:0;text-align:center;align-items:center;}
    .cenario-copy{align-items:center;gap:20px;}
    .cenario-copy h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .cenario-media{display:none;}

    .story-section{padding:48px 24px;}
    .story-section + .story-section{padding-top:0;}
    .story-section + .story-section .story-wrap{padding-top:40px;}
    .story-section:has(+ .story-section){padding-bottom:40px;}
    .story-wrap{grid-template-columns:minmax(0,1fr);gap:16px;text-align:center;}
    .story-head{align-items:center;}
    .story-wrap h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .story-body{padding-top:0;font-size:16px;line-height:26px;}

    /* Stacked: heading, list, then the CTA (aside is flattened so the CTA can move below). */
    .beneficios{padding:48px 24px 60px;display:flex;flex-direction:column;gap:28px;}
    .beneficios-aside{display:contents;}
    .beneficios-head{align-items:center;text-align:center;align-self:center;width:100%;max-width:640px;}
    .beneficios-head h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .beneficios-head p{font-size:16px;line-height:26px;}
    /* Centered block, checks and text left-aligned inside (same idea as the home lists). */
    .beneficios-list{order:1;align-self:center;width:100%;max-width:520px;}
    .beneficios-list li{gap:14px;padding:20px 0;}
    .beneficios-list p{font-size:16px;line-height:25px;}
    .beneficios-cta{order:2;align-self:center;}

    .contato-final{padding:60px 24px;gap:32px;}
    .about-panel{margin:0;}
    .about-card{flex-direction:column;text-align:center;padding:32px 24px;gap:16px;}
    .about-card .label{flex:none;max-width:100%;align-items:center;}
    .about-card p{flex:none;max-width:100%;}
    .final-row{flex-direction:column;padding:0;text-align:center;align-items:center;gap:32px;}
    .final-copy{align-items:center;text-align:center;}
    .final-copy h2{font-size:28px;line-height:1.3;letter-spacing:-.5px;}
    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}

    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }

  /* ============ SOLUTION PAGE OVERRIDES (aplicados em todas as páginas de /solucoes/*) ============ */
  .cenario-media{
    flex:0 0 400px;
    width:400px;
    height:560px;
  }

  .cenario-copy h2,
  .story-wrap h2,
  .beneficios-head h2{
    font-size:40px;
    line-height:50px;
    letter-spacing:-2.2px;
  }

  .challenge-label{
    font-size:20px;
    letter-spacing:-0.2px;
  }
  .challenge-text{
    font-size:20px;
    line-height:28px;
    letter-spacing:-0.2px;
  }

  .breadcrumb-wrap{
    padding-top:200px;
  }

  .cenario-copy .btn-primary{
    align-self:flex-start;
  }

  @media (max-width: 1150px){
    .breadcrumb-wrap{padding:100px 24px 0;}
    .breadcrumb{justify-content:center;text-align:center;}

    .hero2{padding:24px 24px 48px;gap:14px;}
    .hero2 h1{font-size:31px;line-height:40px;letter-spacing:-.3px;}
    .hero2 .lead{font-size:16px;}
    .hero-actions{flex-direction:column;gap:16px;width:100%;}
    .hero-actions .btn-primary{width:auto;}

    .cenario-copy .btn-primary{align-self:center;}

    .hero-media{display:none;}

    /* "O desafio" moves into the hero, above the CTAs. */
    .challenge{display:none;}
    .hero-challenge{
      display:flex;flex-direction:column;align-items:center;gap:8px;
      width:100%;margin-top:10px;padding:22px 20px;
      border-radius:16px;background:var(--lavender);
    }
    .hero-challenge-label{font-weight:600;font-size:13px;letter-spacing:1.6px;text-transform:uppercase;color:var(--purple);}
    .hero-challenge-text{font-size:16px;line-height:25px;color:var(--navy);}

    .cenario{padding:48px 24px 60px;}
    .cenario-wrap{flex-direction:column;padding:0;text-align:center;align-items:center;}
    .cenario-copy{align-items:center;gap:20px;}
    .cenario-copy h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .cenario-media{display:none;}

    .story-section{padding:48px 24px;}
    .story-section + .story-section{padding-top:0;}
    .story-section + .story-section .story-wrap{padding-top:40px;}
    .story-section:has(+ .story-section){padding-bottom:40px;}
    .story-wrap{grid-template-columns:minmax(0,1fr);gap:16px;text-align:center;}
    .story-head{align-items:center;}
    .story-wrap h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .story-body{padding-top:0;font-size:16px;line-height:26px;}

    /* Stacked: heading, list, then the CTA (aside is flattened so the CTA can move below). */
    .beneficios{padding:48px 24px 60px;display:flex;flex-direction:column;gap:28px;}
    .beneficios-aside{display:contents;}
    .beneficios-head{align-items:center;text-align:center;align-self:center;width:100%;max-width:640px;}
    .beneficios-head h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .beneficios-head p{font-size:16px;line-height:26px;}
    /* Centered block, checks and text left-aligned inside (same idea as the home lists). */
    .beneficios-list{order:1;align-self:center;width:100%;max-width:520px;}
    .beneficios-list li{gap:14px;padding:20px 0;}
    .beneficios-list p{font-size:16px;line-height:25px;}
    .beneficios-cta{order:2;align-self:center;}

    .contato-final{padding:60px 24px;gap:32px;}
    .about-panel{margin:0;}
    .about-card{flex-direction:column;text-align:center;padding:32px 24px;gap:16px;}
    .about-card .label{flex:none;max-width:100%;align-items:center;}
    .about-card p{flex:none;max-width:100%;}
    .final-row{flex-direction:column;padding:0;text-align:center;align-items:center;gap:16px;}
    .final-copy{flex:0 1 269px;align-items:center;text-align:center;}
    .final-copy h2{font-size:28px;line-height:1.3;letter-spacing:-.5px;}

    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}
  }

  @media (max-width: 1150px){
    section[id]{scroll-margin-top:90px;}

    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(247,244,249,0.96);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);height:76px;padding:0 20px;
      pointer-events:auto;width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }
  /* ============ HERO MOBILE: imagem de fundo ============
     The solution's photo behind the breadcrumb + hero, under a dark brand
     gradient, with the hero copy switched to light colors for contrast.
     (--hero-bg is set per page in SolutionsPage.astro.) */
  @media (max-width: 1150px){
    .breadcrumb-wrap{
      background:
        linear-gradient(180deg, rgba(22,20,50,.78) 0%, rgba(22,20,50,.84) 55%, rgba(22,20,50,.94) 100%),
        var(--hero-bg) center / cover no-repeat,
        var(--near-black);
    }
    .breadcrumb,.breadcrumb a{color:rgba(255,255,255,.7);}
    .breadcrumb strong{color:#fff;}
    .hero2 .eyebrow{color:var(--ice-blue);}
    .hero2 h1{color:#fff;}
    .hero2 .lead{color:rgba(255,255,255,.85);}
    .hero-challenge{
      background:rgba(255,255,255,.08);
      border:1px solid rgba(200,218,235,.22);
      backdrop-filter:blur(6px);
    }
    .hero-challenge-label{color:var(--ice-blue);}
    .hero-challenge-text{color:rgba(255,255,255,.9);}
    .hero-actions .text-link,.hero-actions .text-link span{color:#fff;}
  }
</style>
</head>
<body>
<GtmBody />

<SiteNav />
<slot />
<SiteFooter />

<SiteScripts />

</body>
</html>
