---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-NPWS7CX');</script>
<!-- End Google Tag Manager -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/svg+xml" href="/logos/tinnova-symbol.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  @font-face {
    font-family: 'Geist';
    src: url('/fonts/geist-latin.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root{
    --purple:#6f3996;
    --purple-dark:#3d286d;
    --near-black:#161432;
    --muted-gray:#656a82;
    --ice-blue:#c8daeb;
    --navy:#293354;
    --lavender:#f7f4f9;
    --dark-bg:#1e1e1e;
    --white:#ffffff;
    --border-navy:rgba(41,51,84,0.16);
    --border-navy-2:rgba(41,51,84,0.25);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Poppins',sans-serif;
    color:var(--near-black);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{text-decoration:none;color:inherit;}
  button{font-family:inherit;border:none;background:none;cursor:pointer;}
  ul{list-style:none;margin:0;padding:0;}
  h1,h2,h3,p{margin:0;}

  section[id]{scroll-margin-top:110px;}
  @media (max-width:880px){ section[id]{scroll-margin-top:90px;} }

  .eyebrow{
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:16px;
    letter-spacing:1.92px;
    text-transform:uppercase;
  }

  .btn-primary{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:var(--purple);
    color:#fff;
    font-weight:600;
    font-size:16px;
    padding:15.5px 22px;
    border-radius:3px;
    white-space:nowrap;
    transition:opacity .15s ease;
  }
  .btn-primary:hover{opacity:.88;}
  .btn-pill{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--purple);
    color:var(--ice-blue);
    font-weight:600;
    font-size:16px;
    padding:11px 22px;
    border-radius:29px;
    white-space:nowrap;
    transition:opacity .15s ease;
  }
  .btn-pill:hover{opacity:.88;}
  .nav-cta{color:#fff;}
  .text-link{
    display:inline-flex;
    align-items:center;
    gap:11px;
    font-weight:700;
    font-size:16px;
    color:#fff;
  }

  /* ============ NAVBAR ============ */
  .site-nav{
    position:sticky;
    top:0;
    z-index:1000;
    display:flex;
    justify-content:center;
    pointer-events:none;
    margin-bottom:-99px;
    padding:0 32px;
  }
  .site-nav .nav-pill{
    pointer-events:auto;
    margin-top:27px;
    width:100%;
    max-width:1736px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:30px;
    height:72px;
    padding:0 100px;
    background:rgba(247,244,249,0.8);
    border:1px solid var(--border-navy);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    border-radius:73px;
  }
  .nav-logo{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .nav-logo img{height:41px;width:auto;}
  .nav-links{display:flex;flex:1;align-items:center;justify-content:center;gap:26px;}
  .nav-item{position:relative;}
  .nav-item>a,.nav-item>button{
    display:flex;align-items:center;gap:8px;
    font-weight:500;font-size:14px;color:var(--navy);
    height:31px;padding:0 4px;
  }
  .nav-item .chevron{width:9px;height:5px;transition:transform .15s ease;}
  .nav-item.open .chevron{transform:rotate(180deg);}
  .nav-dropdown{
    display:none;position:absolute;top:calc(100% + 14px);left:50%;
    transform:translateX(-50%);background:#eeebf0;border-radius:14px;
    padding:20px 24px;box-shadow:0 18px 40px rgba(22,20,50,0.16);z-index:20;
  }
  .nav-item.open .nav-dropdown{display:block;}
  .nav-dropdown-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:2px 8px;}
  .nav-dropdown-grid.cols-1{grid-template-columns:minmax(220px,1fr);}
  .nav-dropdown-grid a{
    display:flex;align-items:center;justify-content:center;text-align:center;
    font-weight:600;font-size:12px;color:var(--navy);padding:12px 8px;border-radius:8px;white-space:nowrap;
  }
  .nav-dropdown-grid a:hover{background:rgba(111,57,150,0.08);color:var(--purple);}
  .nav-cta{flex-shrink:0;}
  .mobile-nav{display:none;}

  /* ============ BREADCRUMB ============ */
  .breadcrumb-wrap{max-width:1660px;margin:0 auto;padding:178px 64px 0;}
  .breadcrumb{display:flex;gap:9px;align-items:center;padding-bottom:18px;font-size:12px;color:var(--muted-gray);flex-wrap:wrap;}
  .breadcrumb a{color:var(--muted-gray);}
  .breadcrumb a:hover{color:var(--purple);}
  .breadcrumb strong{color:var(--navy);font-weight:600;}

  /* ============ HERO (product page) ============ */
  .hero2{
    max-width:1660px;margin:0 auto;padding:50px 64px 90px;
    display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center;
  }
  .hero2 .eyebrow{color:var(--purple);}
  .hero2 h1{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;
    color:var(--near-black);max-width:1090px;
  }
  .hero2 .lead{
    font-weight:400;font-size:20px;line-height:26.4px;color:var(--muted-gray);
    max-width:1206px;padding-top:8px;
  }
  .hero-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px 28px;padding-top:16px;}
  .hero-actions .text-link{color:var(--navy);}
  .hero-actions .text-link span{color:var(--purple);}

  .hero-media{width:100%;height:856px;overflow:hidden;background:var(--navy);}
  .hero-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ DESAFIO (challenge) ============ */
  .challenge{
    background:#fff;border-bottom:1px solid var(--border-navy);
    padding:64px 130px;display:flex;justify-content:center;
  }
  .challenge-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;gap:40px;align-items:flex-start;}
  .challenge-label{
    font-family:'Poppins',sans-serif;font-weight:600;font-size:24px;letter-spacing:-0.24px;
    text-transform:uppercase;color:var(--purple-dark);flex:0 0 auto;max-width:260px;
  }
  .challenge-text{
    font-size:24px;line-height:33.6px;letter-spacing:-0.24px;color:var(--muted-gray);
    max-width:975px;
  }

  /* ============ CENARIO ============ */
  .cenario{background:#fff;padding:90px 130px 150px;display:flex;justify-content:center;}
  .cenario-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;gap:44px;align-items:center;}
  .cenario-copy{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:32px;}
  .cenario-copy .eyebrow{color:var(--purple);}
  .cenario-copy h2{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);
    max-width:863px;
  }
  .cenario-copy .body{font-size:16px;line-height:26.4px;color:var(--muted-gray);max-width:849px;}
  .cenario-copy .body p+p{margin-top:20px;}
  .cenario-media{flex:0 0 534px;width:534px;height:640px;overflow:hidden;border-radius:4px;background:var(--lavender);}
  .cenario-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ SOLUCAO / COMO FAZEMOS (centered box) ============ */
  .story-section{background:rgba(245,245,245,0.95);padding:90px 130px;display:flex;justify-content:center;}
  .story-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;flex-direction:column;align-items:center;gap:17px;text-align:center;}
  .story-wrap .eyebrow{color:var(--purple);}
  .story-wrap h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);}
  .story-body{max-width:900px;font-size:16px;line-height:26.4px;color:var(--muted-gray);padding-top:8px;}
  .story-body p+p{margin-top:26px;}

  /* ============ BENEFICIOS ============ */
  .beneficios{background:#fff;padding:90px 130px 150px;display:flex;justify-content:center;}
  .beneficios-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;flex-direction:column;align-items:center;gap:56px;}
  .beneficios-head{max-width:1050px;display:flex;flex-direction:column;align-items:center;gap:17px;text-align:center;}
  .beneficios-head .eyebrow{color:var(--purple);}
  .beneficios-head h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);}
  .beneficios-head p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}
  .beneficios-grid{
    display:flex;width:100%;border:1px solid var(--border-navy);background:var(--border-navy);gap:1px;
  }
  .beneficio{
    background:#fff;flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:center;
    justify-content:center;gap:22px;padding:34px 26px;text-align:center;
  }
  .beneficio img{width:51px;height:51px;}
  .beneficio p{font-size:16px;line-height:26.4px;color:var(--navy);}

  /* ============ CONTATO (about cards + final CTA/form) ============ */
  .contato-final{
    background:linear-gradient(101deg, rgb(61,40,109) 0%, rgb(50,61,114) 100%);
    padding:93px 130px 90px;display:flex;flex-direction:column;align-items:center;gap:65px;
  }
  .about-panel{
    max-width:1660px;width:100%;margin:0 64px;background:#f5f5f5;border:1px solid var(--border-navy);
    border-radius:10px;display:flex;flex-direction:column;
  }
  .about-card{
    display:flex;gap:60px;align-items:center;justify-content:center;padding:47px 40px;
    border-bottom:1px solid rgba(101,106,130,0.49);flex-wrap:wrap;
  }
  .about-card:last-child{border-bottom:none;}
  .about-card .label{
    display:flex;flex-direction:column;gap:13px;flex:0 0 389px;max-width:389px;
  }
  .about-card .tag{font-weight:600;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--purple);}
  .about-card h3{font-weight:600;font-size:22px;letter-spacing:-0.44px;color:var(--near-black);}
  .about-card p{font-size:15px;line-height:24.75px;color:var(--muted-gray);flex:0 0 420px;max-width:420px;}

  .final-row{max-width:1660px;width:100%;padding:23px 64px;display:flex;gap:80px;align-items:flex-start;flex-wrap:wrap;}
  .final-copy{flex:1 1 380px;max-width:760px;display:flex;flex-direction:column;gap:18px;}
  .final-copy .eyebrow{font-size:11px;letter-spacing:1.76px;color:var(--ice-blue);}
  .final-copy h2{font-weight:600;font-size:44px;line-height:47.52px;letter-spacing:-0.88px;color:#fff;}
  .final-copy p{font-size:16px;line-height:26.4px;color:rgba(255,255,255,0.72);max-width:541px;}
  .final-form-wrap{flex:1 1 380px;max-width:560px;width:100%;}

  /* Contact form (shared component, reused from home) */
  .contato-form{background:#fdfcfe;border-radius:6px;padding:28px;box-shadow:0 30px 60px rgba(22,20,50,0.25);}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 24px;}
  .form-field{display:flex;flex-direction:column;gap:6px;}
  .form-field.full{grid-column:1/-1;}
  .form-field label{font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;color:var(--near-black);text-align:left;}
  .form-field input,.form-field textarea{
    font-family:'Poppins',sans-serif;font-size:14px;color:var(--near-black);border:none;
    border-bottom:1px solid var(--border-navy-2);padding:8px 2px;background:transparent;outline:none;
  }
  .form-field input::placeholder,.form-field textarea::placeholder{color:#9a9fb3;}
  .form-field input:focus,.form-field textarea:focus{border-bottom-color:var(--purple);}
  .form-field textarea{resize:vertical;min-height:70px;}
  .form-footer{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:22px;}
  .form-footer small{color:var(--muted-gray);font-size:12px;}
  .form-submit{
    background:var(--purple);color:#fff;font-weight:600;font-size:15px;padding:12px 22px;
    border-radius:4px;display:inline-flex;align-items:center;gap:8px;
  }
  .form-submit:hover{opacity:.9;}
  .form-msg{margin-top:14px;font-size:14px;display:none;}
  .form-msg.show{display:block;}
  .form-msg.ok{color:#2f7d4f;}
  .form-msg.err{color:#c0392b;}

  /* ============ FOOTER ============ */
  .site-footer{background:var(--dark-bg);border-top:1px solid var(--border-navy);padding:92px 130px;}
  .footer-wrap{max-width:1660px;margin:0 auto;}
  .footer-top{display:flex;align-items:center;gap:59px;padding-bottom:44px;flex-wrap:nowrap;}
  .footer-top img{height:63px;width:auto;flex-shrink:0;}
  .footer-top p{color:var(--ice-blue);font-size:22px;line-height:26.4px;}
  .footer-main{display:flex;gap:clamp(20px,3vw,87px);flex-wrap:nowrap;padding-top:26px;}
  .footer-contact{flex:0 1 300px;max-width:472px;min-width:200px;display:flex;flex-direction:column;gap:21px;}
  .footer-contact .title{color:var(--ice-blue);font-weight:500;font-size:16px;}
  .footer-contact .details{color:var(--ice-blue);font-size:14px;line-height:1.8;}
  .footer-contact .details p{font-weight:500;}
  .footer-legal-block{color:var(--ice-blue);display:flex;flex-direction:column;gap:12px;padding-top:20px;}
  .footer-legal-block .addr{font-size:14px;}
  .footer-legal-block .cnpj{font-size:11px;}
  .footer-cols{display:flex;gap:clamp(32px,4vw,72px);flex-wrap:nowrap;flex:1 1 0;min-width:0;}
  .footer-col{display:flex;flex-direction:column;gap:20px;min-width:110px;flex:1 1 110px;}
  .footer-col strong{color:var(--ice-blue);font-weight:600;font-size:15px;letter-spacing:1.32px;text-transform:uppercase;}
  .footer-col a{color:var(--ice-blue);font-size:15px;}
  .footer-col a:hover{opacity:.8;text-decoration:underline;}
  .footer-bottom{color:var(--ice-blue);font-size:15px;padding-top:44px;}

  /* ============ MOBILE HAMBURGER MENU ============ */
  .mobile-menu-overlay{display:none;position:fixed;inset:0;background:var(--lavender);z-index:2000;overflow-y:auto;padding:24px 24px 40px;}
  .mobile-menu-overlay.open{display:block;}
  .mobile-menu-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;}
  .mobile-menu-header img{height:36px;}
  .mobile-menu-close{font-size:28px;line-height:1;color:var(--navy);padding:6px;}
  .mobile-accordion{border-top:1px solid var(--border-navy);}
  .mobile-accordion-item{border-bottom:1px solid var(--border-navy);}
  .mobile-accordion-item>button{width:100%;display:flex;align-items:center;justify-content:space-between;padding:18px 4px;font-weight:600;font-size:16px;color:var(--navy);}
  .mobile-accordion-item .chevron{transition:transform .15s ease;width:10px;height:6px;}
  .mobile-accordion-item.open .chevron{transform:rotate(180deg);}
  .mobile-accordion-panel{display:none;padding:0 4px 18px;}
  .mobile-accordion-item.open .mobile-accordion-panel{display:flex;flex-direction:column;gap:2px;}
  .mobile-accordion-panel a{padding:10px 8px;font-size:14px;font-weight:500;color:var(--muted-gray);}
  .mobile-plain-link{display:flex;align-items:center;justify-content:space-between;padding:18px 4px;font-weight:600;font-size:16px;color:var(--navy);border-bottom:1px solid var(--border-navy);}
  .mobile-menu-cta{margin-top:28px;}
  .mobile-menu-cta .btn-primary{width:100%;justify-content:center;}

  /* ============================================================
     RESPONSIVE — MOBILE (matches Figma mobile frame, 440px, sem imagens)
     ============================================================ */
  @media (max-width: 880px){
    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(247,244,249,0.96);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);height:76px;padding:0 20px;
      pointer-events:auto;width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    .breadcrumb-wrap{padding:100px 24px 0;}
    .breadcrumb{justify-content:center;text-align:center;}

    .hero2{padding:24px 24px 48px;gap:14px;}
    .hero2 h1{font-size:31px;line-height:40px;letter-spacing:-.3px;}
    .hero2 .lead{font-size:16px;}
    .hero-actions{flex-direction:column;gap:16px;width:100%;}
    .hero-actions .btn-primary{width:100%;justify-content:center;}

    .hero-media{display:none;}

    .challenge{padding:48px 24px;}
    .challenge-wrap{flex-direction:column;gap:16px;padding:0;text-align:center;align-items:center;}
    .challenge-text{font-size:18px;line-height:1.5;}

    .cenario{padding:48px 24px 60px;}
    .cenario-wrap{flex-direction:column;padding:0;text-align:center;align-items:center;}
    .cenario-copy{align-items:center;gap:20px;}
    .cenario-copy h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .cenario-media{display:none;}

    .story-section{padding:48px 24px;}
    .story-wrap{padding:0;}
    .story-wrap h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}

    .beneficios{padding:48px 24px 60px;}
    .beneficios-wrap{padding:0;}
    .beneficios-head h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .beneficios-grid{flex-direction:column;}
    .beneficio{border-bottom:1px solid var(--border-navy);}
    .beneficio:last-child{border-bottom:none;}

    .contato-final{padding:60px 24px;gap:32px;}
    .about-panel{margin:0;}
    .about-card{flex-direction:column;text-align:center;padding:32px 24px;gap:16px;}
    .about-card .label{flex:none;max-width:100%;align-items:center;}
    .about-card p{flex:none;max-width:100%;}
    .final-row{flex-direction:column;padding:0;text-align:center;align-items:center;gap:32px;}
    .final-copy{align-items:center;text-align:center;}
    .final-copy h2{font-size:28px;line-height:1.3;letter-spacing:-.5px;}
    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}

    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }
</style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NPWS7CX"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<SiteNav />
<slot />
<SiteFooter />

<script is:inline>
(function(){
  // ---- Desktop dropdowns ----
  var dropdowns = document.querySelectorAll('.nav-item[data-dropdown]');
  dropdowns.forEach(function(item){
    var btn = item.querySelector('button');
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var isOpen = item.classList.contains('open');
      dropdowns.forEach(function(d){ d.classList.remove('open'); d.querySelector('button').setAttribute('aria-expanded','false'); });
      if(!isOpen){
        item.classList.add('open');
        btn.setAttribute('aria-expanded','true');
      }
    });
  });
  document.addEventListener('click', function(){
    dropdowns.forEach(function(d){ d.classList.remove('open'); d.querySelector('button').setAttribute('aria-expanded','false'); });
  });

  // ---- Mobile menu open/close ----
  var overlay = document.getElementById('mobileMenuOverlay');
  var openBtn = document.getElementById('mobileMenuOpen');
  var closeBtn = document.getElementById('mobileMenuClose');
  if(openBtn){
    openBtn.addEventListener('click', function(){
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  }
  if(closeBtn){
    closeBtn.addEventListener('click', closeMobileMenu);
  }
  function closeMobileMenu(){
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('[data-close-mobile-menu]').forEach(function(a){
    a.addEventListener('click', closeMobileMenu);
  });

  // ---- Mobile accordion ----
  document.querySelectorAll('.mobile-accordion-item[data-accordion]').forEach(function(item){
    var btn = item.querySelector('button');
    btn.addEventListener('click', function(){
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.mobile-accordion-item').forEach(function(i){ i.classList.remove('open'); });
      if(!isOpen){ item.classList.add('open'); }
    });
  });

  // Contact form submit handling lives in components/ContactForm.astro
})();
</script>

</body>
</html>
