---
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
import SiteScripts from '../components/SiteScripts.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<GtmHead />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<Seo title={title} description={description} image={image} />
<link rel="icon" type="image/svg+xml" href="/logos/tinnova-symbol.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  section[id]{scroll-margin-top:110px;}
  @media (max-width:880px){ section[id]{scroll-margin-top:90px;} }

  /* ============ BREADCRUMB ============ */
  .breadcrumb-wrap{max-width:1660px;margin:0 auto;padding:178px 64px 0;}
  .breadcrumb{display:flex;gap:9px;align-items:center;padding-bottom:18px;font-size:12px;color:var(--muted-gray);flex-wrap:wrap;}
  .breadcrumb a{color:var(--muted-gray);}
  .breadcrumb a:hover{color:var(--purple);}
  .breadcrumb strong{color:var(--navy);font-weight:600;}

  /* ============ HERO (product page) ============ */
  .hero2{
    max-width:1660px;margin:0 auto;padding:50px 64px 90px;
    display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center;
  }
  .hero2 .eyebrow{color:var(--purple);}
  .hero2 h1{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;
    color:var(--near-black);max-width:1090px;
  }
  .hero2 .lead{
    font-weight:400;font-size:20px;line-height:26.4px;color:var(--muted-gray);
    max-width:1206px;padding-top:8px;
  }
  .hero-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px 28px;padding-top:16px;}
  .hero-actions .text-link{color:var(--navy);}
  .hero-actions .text-link span{color:var(--purple);}

  .hero-media{width:100%;height:856px;overflow:hidden;background:var(--navy);}
  .hero-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ DESAFIO (challenge) ============ */
  .challenge{
    background:#fff;border-bottom:1px solid var(--border-navy);
    padding:64px 130px;display:flex;justify-content:center;
  }
  .challenge-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;gap:40px;align-items:flex-start;}
  .challenge-label{
    font-family:'Poppins',sans-serif;font-weight:600;font-size:24px;letter-spacing:-0.24px;
    text-transform:uppercase;color:var(--purple-dark);flex:0 0 auto;max-width:260px;
  }
  .challenge-text{
    font-size:24px;line-height:33.6px;letter-spacing:-0.24px;color:var(--muted-gray);
    max-width:975px;
  }

  /* ============ CENARIO ============ */
  .cenario{background:#fff;padding:90px 130px 150px;display:flex;justify-content:center;}
  .cenario-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;gap:44px;align-items:center;}
  .cenario-copy{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:32px;}
  .cenario-copy .eyebrow{color:var(--purple);}
  .cenario-copy h2{
    font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);
    max-width:863px;
  }
  .cenario-copy .body{font-size:16px;line-height:26.4px;color:var(--muted-gray);max-width:849px;}
  .cenario-copy .body p+p{margin-top:20px;}
  .cenario-media{flex:0 0 534px;width:534px;height:640px;overflow:hidden;border-radius:4px;background:var(--lavender);}
  .cenario-media img{width:100%;height:100%;object-fit:cover;}

  /* ============ SOLUCAO / COMO FAZEMOS (centered box) ============ */
  .story-section{background:rgba(245,245,245,0.95);padding:90px 130px;display:flex;justify-content:center;}
  .story-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;flex-direction:column;align-items:center;gap:17px;text-align:center;}
  .story-wrap .eyebrow{color:var(--purple);}
  .story-wrap h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);}
  .story-body{max-width:900px;font-size:16px;line-height:26.4px;color:var(--muted-gray);padding-top:8px;}
  .story-body p+p{margin-top:26px;}

  /* ============ BENEFICIOS ============ */
  .beneficios{background:#fff;padding:90px 130px 150px;display:flex;justify-content:center;}
  .beneficios-wrap{max-width:1660px;width:100%;padding:0 64px;display:flex;flex-direction:column;align-items:center;gap:56px;}
  .beneficios-head{max-width:1050px;display:flex;flex-direction:column;align-items:center;gap:17px;text-align:center;}
  .beneficios-head .eyebrow{color:var(--purple);}
  .beneficios-head h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);}
  .beneficios-head p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}
  .beneficios-grid{
    display:flex;width:100%;border:1px solid var(--border-navy);background:var(--border-navy);gap:1px;
  }
  .beneficio{
    background:#fff;flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:center;
    justify-content:center;gap:22px;padding:34px 26px;text-align:center;
  }
  .beneficio img{width:51px;height:51px;}
  .beneficio p{font-size:16px;line-height:26.4px;color:var(--navy);}

  /* ============ CONTATO (about cards + final CTA/form) ============ */
  .contato-final{
    background:linear-gradient(101deg, rgb(61,40,109) 0%, rgb(50,61,114) 100%);
    padding:93px 130px 90px;display:flex;flex-direction:column;align-items:center;gap:65px;
  }
  .about-panel{
    max-width:1660px;width:100%;margin:0 64px;background:#f5f5f5;border:1px solid var(--border-navy);
    border-radius:10px;display:flex;flex-direction:column;
  }
  .about-card{
    display:flex;gap:60px;align-items:center;justify-content:center;padding:47px 40px;
    border-bottom:1px solid rgba(101,106,130,0.49);flex-wrap:wrap;
  }
  .about-card:last-child{border-bottom:none;}
  .about-card .label{
    display:flex;flex-direction:column;gap:13px;flex:0 0 389px;max-width:389px;
  }
  .about-card .tag{font-weight:600;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--purple);}
  .about-card h3{font-weight:600;font-size:22px;letter-spacing:-0.44px;color:var(--near-black);}
  .about-card p{font-size:15px;line-height:24.75px;color:var(--muted-gray);flex:0 0 420px;max-width:420px;}

  .final-row{max-width:1660px;width:100%;padding:23px 64px;display:flex;gap:80px;align-items:flex-start;flex-wrap:wrap;}
  .final-copy{flex:1 1 380px;max-width:760px;display:flex;flex-direction:column;gap:18px;}
  .final-copy .eyebrow{font-size:11px;letter-spacing:1.76px;color:var(--ice-blue);}
  .final-copy h2{font-weight:600;font-size:44px;line-height:47.52px;letter-spacing:-0.88px;color:#fff;}
  .final-copy p{font-size:16px;line-height:26.4px;color:rgba(255,255,255,0.72);max-width:541px;}
  .final-form-wrap{flex:1 1 380px;max-width:560px;width:100%;}

  /* ============================================================
     RESPONSIVE — MOBILE (matches Figma mobile frame, 440px, sem imagens)
     ============================================================ */
  @media (max-width: 880px){
    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(247,244,249,0.96);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);height:76px;padding:0 20px;
      pointer-events:auto;width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    .breadcrumb-wrap{padding:100px 24px 0;}
    .breadcrumb{justify-content:center;text-align:center;}

    .hero2{padding:24px 24px 48px;gap:14px;}
    .hero2 h1{font-size:31px;line-height:40px;letter-spacing:-.3px;}
    .hero2 .lead{font-size:16px;}
    .hero-actions{flex-direction:column;gap:16px;width:100%;}
    .hero-actions .btn-primary{width:100%;justify-content:center;}

    .hero-media{display:none;}

    .challenge{padding:48px 24px;}
    .challenge-wrap{flex-direction:column;gap:16px;padding:0;text-align:center;align-items:center;}
    .challenge-text{font-size:18px;line-height:1.5;}

    .cenario{padding:48px 24px 60px;}
    .cenario-wrap{flex-direction:column;padding:0;text-align:center;align-items:center;}
    .cenario-copy{align-items:center;gap:20px;}
    .cenario-copy h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .cenario-media{display:none;}

    .story-section{padding:48px 24px;}
    .story-wrap{padding:0;}
    .story-wrap h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}

    .beneficios{padding:48px 24px 60px;}
    .beneficios-wrap{padding:0;}
    .beneficios-head h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .beneficios-grid{flex-direction:column;}
    .beneficio{border-bottom:1px solid var(--border-navy);}
    .beneficio:last-child{border-bottom:none;}

    .contato-final{padding:60px 24px;gap:32px;}
    .about-panel{margin:0;}
    .about-card{flex-direction:column;text-align:center;padding:32px 24px;gap:16px;}
    .about-card .label{flex:none;max-width:100%;align-items:center;}
    .about-card p{flex:none;max-width:100%;}
    .final-row{flex-direction:column;padding:0;text-align:center;align-items:center;gap:32px;}
    .final-copy{align-items:center;text-align:center;}
    .final-copy h2{font-size:28px;line-height:1.3;letter-spacing:-.5px;}
    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}

    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }

  /* ============ SOLUTION PAGE OVERRIDES (aplicados em todas as páginas de /solucoes/*) ============ */
  .cenario-media{
    flex:0 0 400px;
    width:400px;
    height:560px;
  }

  .cenario-copy h2,
  .story-wrap h2,
  .beneficios-head h2{
    font-size:40px;
    line-height:50px;
    letter-spacing:-2.2px;
  }

  .challenge-label{
    font-size:20px;
    letter-spacing:-0.2px;
  }
  .challenge-text{
    font-size:20px;
    line-height:28px;
    letter-spacing:-0.2px;
  }

  .breadcrumb-wrap{
    padding-top:200px;
  }

  .cenario-copy .btn-primary{
    align-self:flex-start;
  }

  @media (max-width: 1300px){
    .breadcrumb-wrap{padding:100px 24px 0;}
    .breadcrumb{justify-content:center;text-align:center;}

    .hero2{padding:24px 24px 48px;gap:14px;}
    .hero2 h1{font-size:31px;line-height:40px;letter-spacing:-.3px;}
    .hero2 .lead{font-size:16px;}
    .hero-actions{flex-direction:column;gap:16px;width:100%;}
    .hero-actions .btn-primary{width:auto;}

    .cenario-copy .btn-primary{align-self:center;}

    .hero-media{display:none;}

    .challenge{padding:48px 24px;}
    .challenge-wrap{flex-direction:column;gap:16px;padding:0;text-align:center;align-items:center;}
    .challenge-text{font-size:18px;line-height:1.5;}

    .cenario{padding:48px 24px 60px;}
    .cenario-wrap{flex-direction:column;padding:0;text-align:center;align-items:center;}
    .cenario-copy{align-items:center;gap:20px;}
    .cenario-copy h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .cenario-media{display:none;}

    .story-section{padding:48px 24px;}
    .story-wrap{padding:0;}
    .story-wrap h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}

    .beneficios{padding:48px 24px 60px;}
    .beneficios-wrap{padding:0;}
    .beneficios-head h2{font-size:32px;line-height:1.25;letter-spacing:-1px;}
    .beneficios-grid{flex-direction:column;}
    .beneficio{border-bottom:1px solid var(--border-navy);}
    .beneficio:last-child{border-bottom:none;}

    .contato-final{padding:60px 24px;gap:32px;}
    .about-panel{margin:0;}
    .about-card{flex-direction:column;text-align:center;padding:32px 24px;gap:16px;}
    .about-card .label{flex:none;max-width:100%;align-items:center;}
    .about-card p{flex:none;max-width:100%;}
    .final-row{flex-direction:column;padding:0;text-align:center;align-items:center;gap:16px;}
    .final-copy{flex:0 1 269px;align-items:center;text-align:center;}
    .final-copy h2{font-size:28px;line-height:1.3;letter-spacing:-.5px;}

    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}
  }

  @media (max-width: 1060px){
    section[id]{scroll-margin-top:90px;}

    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(247,244,249,0.96);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);height:76px;padding:0 20px;
      pointer-events:auto;width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }
</style>
</head>
<body>
<GtmBody />

<SiteNav />
<slot />
<SiteFooter />

<SiteScripts />

</body>
</html>
