---
import SolutionLayout from './SolutionLayout.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localeHref, useTranslations } from '../i18n/utils';

const CODIGO_CONDUTA_URL = '/files/Codigo-de-Conduta-e-Etica-Tinnova2026.pdf';
const PRIVACY_EMAIL = 'privacidade@tinnova.com.br';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const homeHref = localeHref(currentLocale, '/');
const topics = t<{ title: string; body: string }[]>('privacy.topics');
const emailLink = `<a href="mailto:${PRIVACY_EMAIL}">${PRIVACY_EMAIL}</a>`;
---
<SolutionLayout title={t('privacy.seoTitle')} description={t('privacy.seoDescription')}>

<main class="privacy-page">
<!-- ============ BREADCRUMB + HERO ============ -->
<div class="breadcrumb-wrap">
  <div class="breadcrumb">
    <a href={homeHref}>{t('solutionsPage.breadcrumbHome')}</a><span>/</span>
    <strong>{t('privacy.breadcrumb')}</strong>
  </div>
  <div class="hero2">
    <p class="eyebrow">{t('privacy.eyebrowLegal')}</p>
    <h1>{t('privacy.title')}</h1>
    <p class="lead">{t('privacy.lead')}</p>
  </div>
</div>

<!-- ============ COLETA / USO / PROTECAO / DIREITOS ============ -->
<section class="story-section privacy-data-section">
  <div class="story-wrap">
    <div class="story-body privacy-data-body">
      <div class="privacy-topics">
        {topics.map((topic, i) => (
          <div class="privacy-topic">
            <h2>{topic.title}</h2>
            {i === 3
              ? <p set:html={topic.body.replace('{email}', emailLink)} />
              : <p>{topic.body}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ ENCARREGADO DE PROTECAO DE DADOS ============ -->
<section class="story-section">
  <div class="story-wrap">
    <p class="eyebrow">{t('privacy.dpoEyebrow')}</p>
    <h2>{t('privacy.dpoTitle')}</h2>
    <div class="story-body">
      <p set:html={t<string>('privacy.dpoText').replace('{email}', emailLink)} />
    </div>
  </div>
</section>

<!-- ============ PRESENTES E BRINDES ============ -->
<section class="story-section">
  <div class="story-wrap">
    <div class="story-body">
      <h2 class="privacy-subtitle">{t('privacy.giftsTitle')}</h2>

      <p><strong>{t('privacy.giftsObjectiveLabel')}</strong><br>{t('privacy.giftsObjectiveText')}</p>
      <p><strong>{t('privacy.giftsDefinitionLabel')}</strong><br>{t('privacy.giftsDefinitionText')}</p>
      <p><strong>{t('privacy.giftsLimitLabel')}</strong><br>{t('privacy.giftsLimitText')}</p>
      <p><strong>{t('privacy.giftsTransparencyLabel')}</strong><br>{t('privacy.giftsTransparencyText')}</p>
      <p><strong>{t('privacy.giftsExceptionsLabel')}</strong><br>{t('privacy.giftsExceptionsText')}</p>
      <p><strong>{t('privacy.giftsConsequencesLabel')}</strong><br>{t('privacy.giftsConsequencesText')}</p>
      <p class="privacy-updated">{t('privacy.giftsUpdated')}</p>
    </div>
  </div>
</section>

<!-- ============ CODIGO DE CONDUTA E ETICA (CTA download) ============ -->
<section class="story-section">
  <div class="story-wrap">
    <p class="eyebrow">{t('privacy.codeEyebrow')}</p>
    <h2>{t('privacy.codeTitle')}</h2>
    <p class="story-body">{t('privacy.codeText')}</p>
    <div class="hero-actions">
      <a href={CODIGO_CONDUTA_URL} target="_blank" rel="noopener" class="btn-primary">{t('privacy.codeCta')} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

</main>
</SolutionLayout>

<style is:global>
  .privacy-page {
    --page-pad: 34px;
  }

  .privacy-page .story-section {
    padding-top: 34px;
    padding-bottom: 34px;
  }

  /* Below 1150px the solution layout paints the hero dark over a per-page
     photo (--hero-bg) and turns its text white; the legal pages have no
     photo, so they keep the light desktop hero. */
  .privacy-page .breadcrumb-wrap { background: none; }
  .privacy-page .breadcrumb,
  .privacy-page .breadcrumb a { color: var(--muted-gray); }
  .privacy-page .breadcrumb strong { color: var(--navy); }
  .privacy-page .hero2 .eyebrow { color: var(--purple); }
  .privacy-page .hero2 h1 { color: var(--near-black); white-space: pre-line; }
  .privacy-page .hero2 .lead { color: var(--muted-gray); }

  /* The solution pages lay .story-wrap out as a two-column grid; the legal
     pages are a single centered column of reading text. */
  .privacy-page .story-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .privacy-page .story-body {
    padding-top: 0;
    width: 100%;
  }

  .privacy-page .privacy-subtitle {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--near-black);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .privacy-page .privacy-updated {
    color: var(--muted-gray);
    font-size: 14px;
  }

  .privacy-page .privacy-topics {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    text-align: center;
  }

  .privacy-page .privacy-data-body {
    width: 100%;
  }

  .privacy-page .privacy-topic {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .privacy-page .privacy-topic h2 {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--near-black);
    font-weight: 600;
  }
</style>
