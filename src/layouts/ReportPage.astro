---
import SolutionLayout from './SolutionLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localeHref, useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const homeHref = localeHref(currentLocale, '/');
const objectives = t<{ title: string; body: string }[]>('report.objectives');
---
<SolutionLayout title={t('report.seoTitle')} description={t('report.seoDescription')}>

<main class="privacy-page">
<!-- ============ BREADCRUMB + HERO ============ -->
<div class="breadcrumb-wrap">
  <div class="breadcrumb">
    <a href={homeHref}>{t('solutionsPage.breadcrumbHome')}</a><span>/</span>
    <strong>{t('report.breadcrumb')}</strong>
  </div>
  <div class="hero2">
    <p class="eyebrow">{t('report.eyebrowLegal')}</p>
    <h1>{t('report.title')}</h1>
    <p class="lead">{t('report.lead')}</p>
  </div>
</div>

<!-- ============ OBJETIVOS DO PROGRAMA ============ -->
<section class="story-section privacy-data-section">
  <div class="story-wrap" style="text-align:center;align-items:center;max-width:1000px;margin:0 auto;">
    <p class="eyebrow">{t('report.objectivesEyebrow')}</p>
    <div class="story-body privacy-data-body">
      <div class="privacy-topics">
        {objectives.map((item) => (
          <div class="privacy-topic">
            <h2>{item.title}</h2>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ CANAL DE DENUNCIAS ============ -->
<section class="story-section" style="background:rgba(245,245,245,0.95);">
  <div class="story-wrap" style="text-align:left;align-items:flex-start;max-width:1000px;margin:0 auto;">
    <p class="eyebrow">{t('report.channelEyebrow')}</p>
    <div class="story-body">
      <p>{t('report.channelText')}</p>
    </div>
  </div>
</section>

<!-- ============ FORMULARIO ============ -->
<section class="story-section" id="formulario">
  <div class="story-wrap">
    <p class="eyebrow">{t('report.formEyebrow')}</p>
    <h2>{t('report.formTitle')}</h2>
    <div class="final-form-wrap" style="margin-top:24px;width:100%;max-width:640px;">
      <ReportForm />
    </div>
  </div>
</section>

</main>
</SolutionLayout>

<style is:global>
  .privacy-page {
    --page-pad: 34px;
  }

  .privacy-page .story-section {
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .privacy-page .privacy-topics {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    text-align: center;
  }

  .privacy-page .privacy-data-body {
    width: 100%;
  }

  .privacy-page .privacy-topic {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .privacy-page .privacy-topic h2 {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--near-black);
    font-weight: 600;
  }
</style>
