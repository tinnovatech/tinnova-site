---
import SolutionLayout from './SolutionLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localeHref, useTranslations } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(currentLocale);
const homeHref = localeHref(currentLocale, '/');
const objectives = t<{ title: string; body: string }[]>('report.objectives');
---
<SolutionLayout title={t('report.seoTitle')} description={t('report.seoDescription')}>

<main class="privacy-page">
<!-- ============ BREADCRUMB + HERO ============ -->
<div class="breadcrumb-wrap">
  <div class="breadcrumb">
    <a href={homeHref}>{t('solutionsPage.breadcrumbHome')}</a><span>/</span>
    <strong>{t('report.breadcrumb')}</strong>
  </div>
  <div class="hero2">
    <p class="eyebrow">{t('report.eyebrowLegal')}</p>
    <h1>{t('report.title')}</h1>
    <p class="lead">{t('report.lead')}</p>
  </div>
</div>

<!-- ============ OBJETIVOS DO PROGRAMA ============ -->
<section class="story-section privacy-data-section">
  <div class="story-wrap">
    <p class="eyebrow">{t('report.objectivesEyebrow')}</p>
    <div class="story-body privacy-data-body">
      <div class="privacy-topics">
        {objectives.map((item) => (
          <div class="privacy-topic">
            <h2>{item.title}</h2>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ CANAL DE DENUNCIAS ============ -->
<section class="story-section">
  <div class="story-wrap">
    <p class="eyebrow">{t('report.channelEyebrow')}</p>
    <div class="story-body">
      <p>{t('report.channelText')}</p>
    </div>
  </div>
</section>

<!-- ============ FORMULARIO ============ -->
<section class="story-section" id="formulario">
  <div class="story-wrap">
    <p class="eyebrow">{t('report.formEyebrow')}</p>
    <h2>{t('report.formTitle')}</h2>
    <div class="final-form-wrap">
      <ReportForm />
    </div>
  </div>
</section>

</main>
</SolutionLayout>

<style is:global>
  .privacy-page {
    --page-pad: 34px;
  }

  .privacy-page .story-section {
    padding-top: 34px;
    padding-bottom: 34px;
  }

  /* Below 1150px the solution layout paints the hero dark over a per-page
     photo (--hero-bg) and turns its text white; the legal pages have no
     photo, so they keep the light desktop hero. */
  .privacy-page .breadcrumb-wrap { background: none; }
  .privacy-page .breadcrumb,
  .privacy-page .breadcrumb a { color: var(--muted-gray); }
  .privacy-page .breadcrumb strong { color: var(--navy); }
  .privacy-page .hero2 .eyebrow { color: var(--purple); }
  .privacy-page .hero2 h1 { color: var(--near-black); }
  .privacy-page .hero2 .lead { color: var(--muted-gray); }

  /* The solution pages lay .story-wrap out as a two-column grid; the legal
     pages are a single centered column of reading text. */
  .privacy-page .story-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .privacy-page .story-body {
    padding-top: 0;
    width: 100%;
  }

  .privacy-page .final-form-wrap {
    flex: none;
    width: 100%;
    max-width: 640px;
    margin-top: 8px;
    text-align: left;
  }

  .privacy-page .privacy-topics {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    text-align: center;
  }

  .privacy-page .privacy-data-body {
    width: 100%;
  }

  .privacy-page .privacy-topic {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .privacy-page .privacy-topic h2 {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--near-black);
    font-weight: 600;
  }
</style>
