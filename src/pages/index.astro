<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/svg+xml" href="/logos/tinnova-symbol.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  @font-face {
    font-family: 'Geist';
    src: url('/fonts/geist-latin.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root{
    --purple:#6f3996;
    --purple-dark:#3d286d;
    --near-black:#161432;
    --muted-gray:#656a82;
    --ice-blue:#c8daeb;
    --navy:#293354;
    --lavender:#f7f4f9;
    --dark-bg:#1e1e1e;
    --white:#ffffff;
    --border-navy:rgba(41,51,84,0.16);
    --border-navy-2:rgba(41,51,84,0.25);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Poppins',sans-serif;
    color:var(--near-black);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{text-decoration:none;color:inherit;}
  button{font-family:inherit;border:none;background:none;cursor:pointer;}
  ul{list-style:none;margin:0;padding:0;}
  h1,h2,h3,p{margin:0;}

  .container{
    max-width:1696px;
    margin:0 auto;
    padding:0 112px;
  }

  section[id]{scroll-margin-top:110px;}
  @media (max-width:1300px){ section[id]{scroll-margin-top:90px;} }

  .eyebrow{
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:16px;
    letter-spacing:1.92px;
    text-transform:uppercase;
  }

  .btn-primary{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:var(--purple);
    color:#fff;
    font-weight:600;
    font-size:16px;
    padding:15.5px 22px;
    border-radius:3px;
    white-space:nowrap;
    transition:opacity .15s ease;
  }
  .btn-primary:hover{opacity:.88;}
  .btn-pill{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--purple);
    color:var(--ice-blue);
    font-weight:600;
    font-size:16px;
    padding:11px 22px;
    border-radius:29px;
    white-space:nowrap;
    transition:opacity .15s ease;
  }
  .btn-pill:hover{opacity:.88;}
  .nav-cta{color:#fff;} /* navbar CTA uses white text; only the footer "Fale Conosco" pill uses ice-blue */
  .text-link{
    display:inline-flex;
    align-items:center;
    gap:11px;
    font-weight:700;
    font-size:16px;
    color:#fff;
  }

  /* ============ PLACEHOLDER IMAGES ============ */
  .img-placeholder{
    position:relative;
    overflow:hidden;
    background-size:cover;
    background-position:center;
  }

  /* ============ NAVBAR ============ */
  .site-nav{
    position:sticky;
    top:0;
    z-index:1000;
    display:flex;
    justify-content:center;
    pointer-events:none;
    margin-bottom:-99px; /* pulls the hero section up so the pill floats over the photo, matching Figma */
    padding:0 32px;
  }
  .site-nav .nav-pill{
    pointer-events:auto;
    margin-top:27px;
    width:100%;
    max-width:1736px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:30px;
    height:72px;
    padding:0 100px;
    background:rgba(247,244,249,0.8);
    border:1px solid var(--border-navy);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    border-radius:73px;
  }
  .nav-logo{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .nav-logo img{height:41px;width:auto;}
  .nav-links{
    display:flex;
    flex:1;
    align-items:center;
    justify-content:center;
    gap:26px;
  }
  .nav-item{position:relative;}
  .nav-item>a,.nav-item>button{
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:500;
    font-size:14px;
    color:var(--navy);
    height:31px;
    padding:0 4px;
  }
  .nav-item .chevron{
    width:9px;height:5px;
    transition:transform .15s ease;
  }
  .nav-item.open .chevron{transform:rotate(180deg);}

  .nav-dropdown{
    display:none;
    position:absolute;
    top:calc(100% + 14px);
    left:50%;
    transform:translateX(-50%);
    background:#eeebf0;
    border-radius:14px;
    padding:20px 24px;
    box-shadow:0 18px 40px rgba(22,20,50,0.16);
    z-index:20;
  }
  .nav-item.open .nav-dropdown{display:block;}
  .nav-dropdown-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(180px,1fr));
    gap:2px 8px;
  }
  .nav-dropdown-grid.cols-1{grid-template-columns:minmax(220px,1fr);}
  .nav-dropdown-grid a{
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    font-weight:600;
    font-size:12px;
    color:var(--navy);
    padding:12px 8px;
    border-radius:8px;
    white-space:nowrap;
  }
  .nav-dropdown-grid a:hover{background:rgba(111,57,150,0.08);color:var(--purple);}

  .nav-cta{flex-shrink:0;}

  /* Mobile nav (hidden on desktop) */
  .mobile-nav{display:none;}

  /* ============ HERO ============ */
  .hero{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    padding:200px 112px 90px 194px;
    min-height:897px;
    overflow:hidden;
  }
  .hero-bg{
    position:absolute;
    inset:0;
    z-index:-1;
    background:
      linear-gradient(118.77deg, rgb(0,0,0) 13.028%, rgba(0,0,0,0) 46.65%),
      url('/images/hero-banner.webp');
    background-size:cover;
    background-position:center;
  }
  .hero-copy{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:38px;
    max-width:820px;
    width:100%;
  }
  .hero-copy .eyebrow{color:var(--ice-blue);font-family:'Geist',sans-serif;font-weight:700;font-size:12px;}
  .hero-copy h1{
    font-weight:600;
    font-size:70px;
    line-height:79px;
    letter-spacing:-4.32px;
    color:#fff;
  }
  .hero-copy .lead{
    font-weight:400;
    font-size:20px;
    line-height:26.4px;
    color:#fff;
    max-width:690px;
  }
  .hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:20px 32px;
    padding-top:20px;
  }

  /* ============ PILARES DE CONFIANÇA ============ */
  .pilares{
    background:var(--navy);
    padding:20px 112px;
  }
  .pilares .container{
    padding:0;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:27px;
    flex-wrap:wrap;
  }
  .pilares-label{
    flex:1 0 260px;
    color:var(--ice-blue);
    font-weight:600;
    font-size:16px;
    letter-spacing:1.92px;
    text-transform:uppercase;
    text-align:right;
  }
  .pilares-logos{
    display:flex;
    align-items:center;
    gap:44px;
    flex-wrap:wrap;
  }
  .pilares-logos img{
    height:28px;
    width:auto;
    display:block;
  }

  /* ============ DESAFIO REAL ============ */
  .desafio{
    background:#fff;
    padding:90px 112px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:46px;
  }
  .section-intro{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:21px;
    max-width:880px;
    text-align:center;
  }
  .section-intro .eyebrow{color:var(--purple);}
  .section-intro h2{
    font-weight:500;
    font-size:55px;
    line-height:69.36px;
    letter-spacing:-3.06px;
    color:var(--near-black);
  }
  .section-copy{
    max-width:1060px;
    text-align:center;
    font-size:20px;
    line-height:26.4px;
    color:var(--muted-gray);
  }
  .challenge-grid{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    width:100%;
  }
  .challenge-card{
    flex:1 1 280px;
    max-width:381px;
    min-height:300px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:25px;
    text-align:center;
    padding:30px 28px;
    background:rgba(200,218,235,0.43);
    border-right:0.5px solid var(--border-navy);
  }
  .challenge-card:last-child{border-right:none;}
  .challenge-card svg,.challenge-card img{width:64px;height:64px;color:var(--navy);}
  .challenge-card h3{font-weight:700;font-size:18px;line-height:25.2px;color:var(--near-black);}
  .challenge-card p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}

  /* ============ NOSSO METODO ============ */
  .metodo{
    background:var(--lavender);
    padding:90px 112px 150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:70px;
  }
  .metodo-title{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:21px;
    max-width:900px;
    text-align:center;
  }
  .metodo-title .eyebrow{color:var(--purple);}
  .metodo-title h2{
    font-weight:500;
    font-size:55px;
    line-height:69.36px;
    letter-spacing:-3.06px;
    color:var(--near-black);
  }
  .metodo-content{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:clamp(32px,5vw,96px);
    width:100%;
    flex-wrap:nowrap;
  }
  .metodo-image{
    width:489px;
    max-width:34%;
    aspect-ratio:489/719;
    height:auto;
    flex:0 1 489px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(113.54deg, rgba(200,218,235,0.32) 0%, rgba(247,244,249,0.8) 100%);
    border:1px solid rgba(41,51,84,0.08);
  }
  .metodo-image img{width:100%;height:100%;object-fit:cover;box-shadow:0 20px 50px rgba(22,20,50,0.15);}
  .metodo-steps-wrap{display:flex;flex-direction:column;gap:44px;max-width:750px;flex:1 1 420px;min-width:0;}
  .metodo-steps{
    border-top:1px solid var(--border-navy);
    width:100%;
  }
  .metodo-step{
    display:flex;
    gap:16px;
    align-items:center;
    padding:25px 0;
    border-bottom:1px solid var(--border-navy);
  }
  .metodo-step .num{
    flex:0 0 60px;
    text-align:right;
    font-family:'Poppins',sans-serif;
    font-weight:500;
    font-size:30px;
    color:var(--purple);
  }
  .metodo-step h3{font-family:'Geist',sans-serif;font-weight:700;font-size:21px;color:var(--near-black);margin-bottom:7px;}
  .metodo-step p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}

  /* ============ CASES ============ */
  .cases{
    background-color:#161432;
    padding:90px 112px 150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:75px;
  }
  .cases .section-intro h2{color:#fff;}
  .cases .section-intro .eyebrow{color:var(--ice-blue);}
  .cases .section-copy{color:#fff;}
  .cases-grid{
    display:flex;
    gap:18px;
    width:100%;
    flex-wrap:wrap;
  }
  .case-card{
    flex:1 1 300px;
    background:var(--navy);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }
  .case-card .case-image{
    position:relative;
    height:300px;
    background:rgba(200,218,235,0.08);
    border-bottom:1px solid rgba(200,218,235,0.16);
    background-size:cover;
    background-position:center;
  }
  .case-card .case-logo-badge{
    position:absolute;
    top:20px;left:20px;
    color:#fff;
    font-family:'Geist',sans-serif;
    font-weight:700;
    font-size:15px;
    background:rgba(22,20,50,0.35);
    padding:6px 10px;
    border-radius:4px;
    backdrop-filter:blur(4px);
  }
  .case-body{padding:32px 28px 29px;display:flex;flex-direction:column;gap:13px;}
  .case-body .case-eyebrow{
    font-family:'Geist',sans-serif;
    font-size:11px;
    letter-spacing:1.32px;
    text-transform:uppercase;
    color:var(--ice-blue);
  }
  .case-body h3{font-family:'Geist',sans-serif;font-weight:700;font-size:24px;color:#fff;}
  .case-body p{font-size:16px;line-height:26.4px;color:var(--ice-blue);}

  /* ============ CAPACIDADE TECNICA ============ */
  .capacidade{
    background:var(--lavender);
    padding:90px 112px 150px;
    display:flex;
    justify-content:center;
  }
  .capacidade .container{padding:0;display:flex;gap:80px;flex-wrap:wrap;}
  .capacidade-copy{flex:1 1 420px;max-width:774px;display:flex;flex-direction:column;justify-content:center;gap:21px;}
  .capacidade-copy .eyebrow{color:var(--purple);}
  .capacidade-copy h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);max-width:697px;}
  .capacidade-copy p{font-family:'Geist',sans-serif;font-size:16px;line-height:26.4px;color:var(--navy);max-width:560px;}
  .capacidade-list{flex:1 1 480px;border-top:1px solid var(--border-navy-2);}
  .capacidade-row{
    display:flex;
    align-items:center;
    gap:16px;
    padding:28px 0;
    border-bottom:1px solid var(--border-navy-2);
  }
  .capacidade-row .num{flex:0 0 52px;text-align:right;font-weight:500;font-size:30px;color:var(--purple);}
  .capacidade-row .title{flex:1;font-weight:600;font-size:18px;color:var(--near-black);}
  .capacidade-row .arrow{font-family:'Geist',sans-serif;font-size:14px;color:var(--purple-dark);}

  /* ============ CONTATO ============ */
  .contato{
    background:linear-gradient(125.45deg, rgb(61,40,109) 0%, rgb(50,61,114) 100%);
    padding:90px 112px 150px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:77px;
    flex-wrap:wrap;
  }
  .contato-copy{flex:1 1 420px;max-width:715px;display:flex;flex-direction:column;gap:21px;}
  .contato-copy .eyebrow{color:var(--ice-blue);}
  .contato-copy h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:#fff;max-width:645px;}
  .contato-copy p{font-size:20px;line-height:26.4px;color:rgba(255,255,255,0.72);max-width:546px;}

  .contato-form-wrap{flex:1 1 420px;max-width:886px;width:100%;}
  .contato-form{
    background:#fdfcfe;
    border-radius:6px;
    padding:28px;
    box-shadow:0 30px 60px rgba(22,20,50,0.25);
  }
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 24px;}
  .form-field{display:flex;flex-direction:column;gap:6px;}
  .form-field.full{grid-column:1/-1;}
  .form-field label{font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;color:var(--near-black);text-align:left;}
  .form-field input,.form-field textarea{
    font-family:'Poppins',sans-serif;
    font-size:14px;
    color:var(--near-black);
    border:none;
    border-bottom:1px solid var(--border-navy-2);
    padding:8px 2px;
    background:transparent;
    outline:none;
  }
  .form-field input::placeholder,.form-field textarea::placeholder{color:#9a9fb3;}
  .form-field input:focus,.form-field textarea:focus{border-bottom-color:var(--purple);}
  .form-field textarea{resize:vertical;min-height:70px;}
  .form-footer{
    display:flex;
    align-items:center;
    gap:16px;
    flex-wrap:wrap;
    margin-top:22px;
  }
  .form-footer small{color:var(--muted-gray);font-size:12px;}
  .form-submit{
    background:var(--purple);
    color:#fff;
    font-weight:600;
    font-size:15px;
    padding:12px 22px;
    border-radius:4px;
    display:inline-flex;
    align-items:center;
    gap:8px;
  }
  .form-submit:hover{opacity:.9;}
  .form-msg{margin-top:14px;font-size:14px;display:none;}
  .form-msg.show{display:block;}
  .form-msg.ok{color:#2f7d4f;}
  .form-msg.err{color:#c0392b;}

  /* ============ FOOTER ============ */
  .site-footer{
    background:var(--dark-bg);
    border-top:1px solid var(--border-navy);
    padding:92px 130px;
  }
  .footer-wrap{max-width:1660px;margin:0 auto;}
  .footer-top{display:flex;align-items:center;gap:59px;padding-bottom:44px;flex-wrap:nowrap;}
  .footer-top img{height:63px;width:auto;flex-shrink:0;}
  .footer-top p{color:var(--ice-blue);font-size:22px;line-height:26.4px;}
  .footer-main{display:flex;gap:clamp(20px,3vw,87px);flex-wrap:nowrap;padding-top:26px;}
  .footer-contact{flex:0 1 300px;max-width:472px;min-width:200px;display:flex;flex-direction:column;gap:21px;}
  .footer-contact .title{color:var(--ice-blue);font-weight:500;font-size:16px;}
  .footer-contact .details{color:var(--ice-blue);font-size:14px;line-height:1.8;}
  .footer-contact .details p{font-weight:500;}
  .footer-legal-block{color:var(--ice-blue);display:flex;flex-direction:column;gap:12px;padding-top:20px;}
  .footer-legal-block .addr{font-size:14px;}
  .footer-legal-block .cnpj{font-size:11px;}
  .footer-cols{display:flex;gap:clamp(32px,4vw,72px);flex-wrap:nowrap;flex:1 1 0;min-width:0;}
  .footer-col{display:flex;flex-direction:column;gap:20px;min-width:110px;flex:1 1 110px;}
  .footer-col strong{color:var(--ice-blue);font-weight:600;font-size:15px;letter-spacing:1.32px;text-transform:uppercase;}
  .footer-col a{color:var(--ice-blue);font-size:15px;}
  .footer-col a:hover{opacity:.8;text-decoration:underline;}
  .footer-bottom{color:var(--ice-blue);font-size:15px;padding-top:44px;}

  /* ============ MOBILE HAMBURGER MENU ============ */
  .mobile-menu-overlay{
    display:none;
    position:fixed;inset:0;
    background:var(--lavender);
    z-index:2000;
    overflow-y:auto;
    padding:24px 24px 40px;
  }
  .mobile-menu-overlay.open{display:block;}
  .mobile-menu-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;}
  .mobile-menu-header img{height:36px;}
  .mobile-menu-close{font-size:28px;line-height:1;color:var(--navy);padding:6px;}
  .mobile-accordion{border-top:1px solid var(--border-navy);}
  .mobile-accordion-item{border-bottom:1px solid var(--border-navy);}
  .mobile-accordion-item>button{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 4px;
    font-weight:600;
    font-size:16px;
    color:var(--navy);
  }
  .mobile-accordion-item .chevron{transition:transform .15s ease;width:10px;height:6px;}
  .mobile-accordion-item.open .chevron{transform:rotate(180deg);}
  .mobile-accordion-panel{display:none;padding:0 4px 18px;}
  .mobile-accordion-item.open .mobile-accordion-panel{display:flex;flex-direction:column;gap:2px;}
  .mobile-accordion-panel a{padding:10px 8px;font-size:14px;font-weight:500;color:var(--muted-gray);}
  .mobile-plain-link{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 4px;font-weight:600;font-size:16px;color:var(--navy);
    border-bottom:1px solid var(--border-navy);
  }
  .mobile-menu-cta{margin-top:28px;}
  .mobile-menu-cta .btn-primary{width:100%;justify-content:center;}

  /* ============================================================
     RESPONSIVE — MOBILE (matches Figma "home_mobile" frame, 440px)
     ============================================================ */
  @media (max-width: 1300px){
