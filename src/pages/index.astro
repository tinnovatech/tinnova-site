---
const title = "Tinnova — Consultoria em tecnologia para desafios de negócio";
const description = "Entendemos seu contexto para desenvolver software sob medida, formar squads de tecnologia e evoluir sistemas com consistência.";
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
import SiteScripts from '../components/SiteScripts.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import TrustPillars from '../components/TrustPillars.astro';
import ChallengeSection from '../components/ChallengeSection.astro';
import MethodSection from '../components/MethodSection.astro';
import CasesSection from '../components/CasesSection.astro';
import CapacitySection from '../components/CapacitySection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<GtmHead />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<Seo title={title} description={description} />
<link rel="icon" type="image/svg+xml" href="/logos/tinnova-symbol.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  .container{
    max-width:1696px;
    margin:0 auto;
    padding:0 112px;
  }

  section[id]{scroll-margin-top:110px;}
  @media (max-width:1300px){ section[id]{scroll-margin-top:90px;} }

  /* ============ PLACEHOLDER IMAGES ============ */
  .img-placeholder{
    position:relative;
    overflow:hidden;
    background-size:cover;
    background-position:center;
  }

  /* ============ HERO ============ */
  .hero{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    padding:200px var(--page-pad) 90px;
    min-height:897px;
    overflow:hidden;
  }
  .hero-bg{
    position:absolute;
    inset:0;
    z-index:-1;
    background:
      linear-gradient(118.77deg, rgb(0,0,0) 13.028%, rgba(0,0,0,0) 46.65%),
      url('/images/hero-banner.webp');
    background-size:cover;
    background-position:center;
  }
  .hero-copy{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:38px;
    max-width:820px;
    width:100%;
  }
  .hero-copy .eyebrow{color:var(--ice-blue);font-family:'Geist',sans-serif;font-weight:700;font-size:12px;}
  .hero-copy h1{
    font-weight:600;
    font-size:70px;
    line-height:79px;
    letter-spacing:-4.32px;
    color:#fff;
  }
  .hero-copy .lead{
    font-weight:400;
    font-size:20px;
    line-height:26.4px;
    color:#fff;
    max-width:690px;
  }
  .hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:20px 32px;
    padding-top:20px;
  }

  /* ============ PILARES DE CONFIANÇA ============ */
  .pilares{
    background:var(--navy);
    padding:20px var(--page-pad);
  }
  .pilares .container{
    padding:0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:27px;
    flex-wrap:wrap;
  }
  .pilares-label{
    color:var(--ice-blue);
    font-weight:600;
    font-size:16px;
    letter-spacing:1.92px;
    text-transform:uppercase;
  }
  .pilares-logos{
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:clamp(20px,2vw,44px);
    flex-wrap:wrap;
    margin-left:auto;
    --logo-h:clamp(20px,1.6vw,28px);
  }
  .pilares-logos img{
    height:var(--logo-h);
    width:auto;
    display:block;
  }

  /* ============ DESAFIO REAL ============ */
  .desafio{
    background:#fff;
    padding:90px var(--page-pad);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:46px;
  }
  .section-intro{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:21px;
    max-width:880px;
    text-align:center;
  }
  .section-intro .eyebrow{color:var(--purple);}
  .section-intro h2{
    font-weight:500;
    font-size:55px;
    line-height:69.36px;
    letter-spacing:-3.06px;
    color:var(--near-black);
  }
  .section-copy{
    max-width:1060px;
    text-align:center;
    font-size:20px;
    line-height:26.4px;
    color:var(--muted-gray);
  }
  .challenge-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    width:100%;
  }
  .challenge-card{
    min-height:300px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:25px;
    text-align:center;
    padding:30px 28px;
    background:rgba(200,218,235,0.43);
    border-right:0.5px solid var(--border-navy);
  }
  .challenge-card:last-child{border-right:none;}
  .challenge-card svg,.challenge-card img{width:64px;height:64px;color:var(--navy);}
  .challenge-card h3{font-weight:700;font-size:18px;line-height:25.2px;color:var(--near-black);}
  .challenge-card p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}

  /* ============ NOSSO METODO ============ */
  .metodo{
    background:var(--lavender);
    padding:90px var(--page-pad) 150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:70px;
  }
  .metodo-title{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:21px;
    max-width:900px;
    text-align:center;
  }
  .metodo-title .eyebrow{color:var(--purple);}
  .metodo-title h2{
    font-weight:500;
    font-size:55px;
    line-height:69.36px;
    letter-spacing:-3.06px;
    color:var(--near-black);
  }
  .metodo-content{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:clamp(32px,5vw,96px);
    width:100%;
    flex-wrap:nowrap;
  }
  .metodo-image{
    width:489px;
    max-width:34%;
    aspect-ratio:489/719;
    height:auto;
    flex:0 1 489px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(113.54deg, rgba(200,218,235,0.32) 0%, rgba(247,244,249,0.8) 100%);
    border:1px solid rgba(41,51,84,0.08);
  }
  .metodo-image img{width:100%;height:100%;object-fit:cover;box-shadow:0 20px 50px rgba(22,20,50,0.15);}
  .metodo-steps-wrap{display:flex;flex-direction:column;gap:44px;flex:1 1 420px;min-width:0;}
  .metodo-steps{
    border-top:1px solid var(--border-navy);
    width:100%;
  }
  .metodo-step{
    display:flex;
    gap:16px;
    align-items:center;
    padding:25px 0;
    border-bottom:1px solid var(--border-navy);
  }
  .metodo-step .num{
    flex:0 0 60px;
    text-align:right;
    font-family:'Poppins',sans-serif;
    font-weight:500;
    font-size:30px;
    color:var(--purple);
  }
  .metodo-step h3{font-family:'Geist',sans-serif;font-weight:700;font-size:21px;color:var(--near-black);margin-bottom:7px;}
  .metodo-step p{font-size:16px;line-height:26.4px;color:var(--muted-gray);}

  /* ============ CASES ============ */
  .cases{
    background-color:#161432;
    padding:90px var(--page-pad) 150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:75px;
  }
  .cases .section-intro h2{color:#fff;}
  .cases .section-intro .eyebrow{color:var(--ice-blue);}
  .cases .section-copy{color:#fff;}
  .cases-grid{
    display:flex;
    gap:18px;
    width:100%;
    flex-wrap:wrap;
  }
  .case-card{
    flex:1 1 300px;
    background:var(--navy);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }
  .case-card .case-image{
    position:relative;
    height:300px;
    background:rgba(200,218,235,0.08);
    border-bottom:1px solid rgba(200,218,235,0.16);
    background-size:cover;
    background-position:center;
  }
  .case-card .case-logo-badge{
    position:absolute;
    top:20px;left:20px;
    color:#fff;
    font-family:'Geist',sans-serif;
    font-weight:700;
    font-size:15px;
    background:rgba(22,20,50,0.35);
    padding:6px 10px;
    border-radius:4px;
    backdrop-filter:blur(4px);
  }
  .case-body{padding:32px 28px 29px;display:flex;flex-direction:column;gap:13px;}
  .case-body .case-eyebrow{
    font-family:'Geist',sans-serif;
    font-size:11px;
    letter-spacing:1.32px;
    text-transform:uppercase;
    color:var(--ice-blue);
  }
  .case-body h3{font-family:'Geist',sans-serif;font-weight:700;font-size:24px;color:#fff;}
  .case-body p{font-size:16px;line-height:26.4px;color:var(--ice-blue);}

  /* ============ CAPACIDADE TECNICA ============ */
  .capacidade{
    background:var(--lavender);
    padding:90px var(--page-pad) 150px;
    display:flex;
    justify-content:center;
  }
  .capacidade .container{padding:0;display:flex;gap:80px;flex-wrap:wrap;}
  .capacidade-copy{flex:1 1 420px;max-width:774px;display:flex;flex-direction:column;justify-content:center;gap:21px;}
  .capacidade-copy .eyebrow{color:var(--purple);}
  .capacidade-copy h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:var(--near-black);max-width:697px;}
  .capacidade-copy p{font-family:'Geist',sans-serif;font-size:16px;line-height:26.4px;color:var(--navy);max-width:560px;}
  .capacidade-list{flex:1 1 480px;border-top:1px solid var(--border-navy-2);}
  .capacidade-row{
    display:flex;
    align-items:center;
    gap:16px;
    padding:28px 0;
    border-bottom:1px solid var(--border-navy-2);
  }
  .capacidade-row .num{flex:0 0 52px;text-align:right;font-weight:500;font-size:30px;color:var(--purple);}
  .capacidade-row .title{flex:1;font-weight:600;font-size:18px;color:var(--near-black);}
  .capacidade-row .arrow{font-family:'Geist',sans-serif;font-size:14px;color:var(--purple-dark);}

  /* ============ CONTATO ============ */
  .contato{
    background:linear-gradient(125.45deg, rgb(61,40,109) 0%, rgb(50,61,114) 100%);
    padding:90px var(--page-pad) 150px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:77px;
    flex-wrap:wrap;
  }
  .contato-copy{flex:1 1 420px;max-width:715px;display:flex;flex-direction:column;gap:21px;}
  .contato-copy .eyebrow{color:var(--ice-blue);}
  .contato-copy h2{font-weight:500;font-size:55px;line-height:69.36px;letter-spacing:-3.06px;color:#fff;max-width:645px;}
  .contato-copy p{font-size:20px;line-height:26.4px;color:rgba(255,255,255,0.72);max-width:546px;}

  .contato-form-wrap{flex:1 1 420px;max-width:886px;width:100%;}

  /* ============================================================
     RESPONSIVE — MOBILE (matches Figma "home_mobile" frame, 440px)
     ============================================================ */
  @media (max-width: 1300px){
    .container{padding:0 24px;}

    /* Navbar */
    .site-nav{margin-bottom:-76px;padding:0;}
    .site-nav .nav-pill{display:none;}
    .mobile-nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      background:rgba(247,244,249,0.96);
      backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border-navy);
      height:76px;
      padding:0 20px;
      pointer-events:auto;
      width:100%;
    }
    .mobile-nav img{height:38px;}
    .mobile-nav .mobile-actions{display:flex;align-items:center;gap:20px;}
    .mobile-nav .icon-btn{width:26px;height:26px;color:var(--navy);}

    /* Hero */
    .hero{padding:110px 24px 60px;min-height:auto;text-align:center;justify-content:center;}
    .hero-bg{
      background-position:left center;
      background:
        linear-gradient(180deg, rgba(22,20,50,0.55) 0%, rgba(22,20,50,0.78) 55%, rgba(22,20,50,0.9) 100%),
        url('/images/hero-banner.webp');
    }
    .hero-copy{align-items:center;text-align:center;gap:16px;max-width:420px;}
    .hero-copy h1{font-size:31px;line-height:44px;letter-spacing:-.3px;}
    .hero-copy .lead{font-size:16px;}
    .hero-cta-row{justify-content:center;}

    /* Pilares */
    .pilares{padding:28px 24px;}
    .pilares .container{justify-content:center;flex-direction:column;gap:20px;}
    .pilares-label{text-align:center;flex:none;}
    .pilares-logos{justify-content:center;gap:28px;margin-left:0;}

    /* Desafio real */
    .desafio{padding:60px 24px;gap:32px;}
    .section-intro h2{font-size:32px;line-height:1.3;letter-spacing:-1px;}
    .section-copy{font-size:16px;}
    .challenge-grid{grid-template-columns:1fr;}
    .challenge-card{border-right:none;border-bottom:0.5px solid var(--border-navy);}
    .challenge-card:last-child{border-bottom:none;}

    /* Metodo */
    .metodo{padding:60px 24px 80px;gap:40px;}
    .metodo-title h2{font-size:32px;line-height:1.3;letter-spacing:-1px;}
    .metodo-content{flex-direction:column;gap:40px;}
    .metodo-image{flex:none;width:100%;max-width:100%;height:340px;aspect-ratio:auto;}
    .metodo-steps-wrap{flex:none;max-width:100%;}

    /* Cases */
    .cases{padding:60px 24px 80px;gap:40px;}
    .cases-grid{flex-direction:column;}
    .case-card{flex:none;max-width:100%;}
    .case-body{align-items:center;text-align:center;}

    /* Capacidade */
    .capacidade{padding:60px 24px 80px;}
    .capacidade .container{flex-direction:column;gap:40px;}
    .capacidade-copy{flex:none;}
    .capacidade-copy h2{font-size:32px;line-height:1.3;letter-spacing:-1px;}
    .capacidade-list{flex:none;}

    /* Contato */
    .contato{padding:60px 24px 80px;flex-direction:column;text-align:center;}
    .contato-copy{flex:none;align-items:center;text-align:center;}
    .contato-form-wrap{flex:none;}
    .contato-copy h2{font-size:32px;line-height:1.3;letter-spacing:-1px;}
    .form-grid{grid-template-columns:1fr;}
    .contato-form{padding:20px;}

    /* Footer */
    .site-footer{padding:60px 24px;}
    .footer-top{flex-direction:column;text-align:center;justify-content:center;gap:16px;}
    .footer-top p{text-align:center;}
    .footer-main{flex-direction:column;align-items:center;text-align:center;gap:36px;}
    .footer-contact{align-items:center;max-width:100%;flex:none;width:100%;}
    .footer-legal-block{align-items:center;}
    .footer-cols{flex-direction:column;flex-wrap:nowrap;justify-content:center;align-items:center;gap:28px;text-align:center;width:100%;}
    .footer-col{align-items:center;min-width:0;flex:none;}
    .footer-bottom{text-align:center;}
  }
</style>
</head>
<body>
<GtmBody />

<SiteNav />
<Hero />
<TrustPillars />
<ChallengeSection />
<MethodSection />
<CasesSection />
<CapacitySection />
<ContactSection />
<SiteFooter />

<SiteScripts />

</body>
</html>
