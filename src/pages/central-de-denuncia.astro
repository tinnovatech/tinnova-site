---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import ReportForm from '../components/ReportForm.astro';

const OBJETIVOS = [
  { h2: 'Detecção e Prevenção', body: 'Identificar riscos e vulnerabilidades que possam levar a comportamentos antiéticos ou ilegais.' },
  { h2: 'Correção de Irregularidades', body: 'Agir com prontidão através de processos de investigação transparentes e justos.' },
  { h2: 'Educação e Conscientização', body: 'Promover cultura de integridade mediante treinamentos contínuos e comunicação de políticas.' },
  { h2: 'Compromisso com a Legalidade', body: 'Assegurar aderência total às leis e regulamentações aplicáveis.' },
];
---
<SolutionLayout title="Central de Denúncia | Tinnova" description="Canal de denúncias do Programa de Integridade Corporativa da Tinnova.">

<main class="privacy-page">
<!-- ============ BREADCRUMB + HERO ============ -->
<div class="breadcrumb-wrap">
  <div class="breadcrumb">
    <a href="/">Home</a><span>/</span>
    <strong>Central de Denúncia</strong>
  </div>
  <div class="hero2">
    <p class="eyebrow">Legal</p>
    <h1>Central de Denúncia</h1>
    <p class="lead">A Tinnova apresenta seu compromisso com os mais altos padrões de ética e conformidade. O Programa de Integridade Corporativa é central para a estratégia de governança da organização.</p>
  </div>
</div>

<!-- ============ OBJETIVOS DO PROGRAMA ============ -->
<section class="story-section privacy-data-section">
  <div class="story-wrap" style="text-align:center;align-items:center;max-width:1000px;margin:0 auto;">
    <p class="eyebrow">Objetivos do Programa</p>
    <div class="story-body privacy-data-body">
      <div class="privacy-topics">
        {OBJETIVOS.map((item) => (
          <div class="privacy-topic">
            <h2>{item.h2}</h2>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ CANAL DE DENUNCIAS ============ -->
<section class="story-section" style="background:rgba(245,245,245,0.95);">
  <div class="story-wrap" style="text-align:left;align-items:flex-start;max-width:1000px;margin:0 auto;">
    <p class="eyebrow">Canal de Denúncias</p>
    <div class="story-body">
      <p>A Tinnova disponibiliza um formulário de denúncia confidencial, acessível a funcionários e parceiros, garantindo anonimato e proteção contra retaliações.</p>
    </div>
  </div>
</section>

<!-- ============ FORMULARIO ============ -->
<section class="story-section" id="formulario">
  <div class="story-wrap">
    <p class="eyebrow">Formulário de Denúncia</p>
    <h2>Registre sua denúncia</h2>
    <div class="final-form-wrap" style="margin-top:24px;width:100%;max-width:640px;">
      <ReportForm />
    </div>
  </div>
</section>

</main>
</SolutionLayout>

<style is:global>
  .privacy-page {
    --page-pad: 34px;
  }

  .privacy-page .story-section {
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .privacy-page .privacy-topics {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    text-align: center;
  }

  .privacy-page .privacy-data-body {
    width: 100%;
  }

  .privacy-page .privacy-topic {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .privacy-page .privacy-topic h2 {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--near-black);
    font-weight: 600;
  }
</style>
